@model List<Notification>
@{ ViewData["Title"] = "Thông báo"; }

<div class="container notifications-page">
    <div class="page-header"><h1>🔔 Thông báo</h1></div>
    @if (!Model.Any())
    {
        <div class="empty-state"><div class="empty-icon">🔕</div><h3>Không có thông báo</h3></div>
    }
    else
    {
        <div class="notifications-list">
            @foreach (var n in Model)
            {
                <a href="@(string.IsNullOrEmpty(n.Link) ? "#" : n.Link)" class="notification-item @(n.IsRead ? "" : "unread")">
                    <span class="notif-icon">@n.Icon</span>
                    <div class="notif-content">
                        <div class="notif-title">@n.Title</div>
                        <div class="notif-msg">@n.Message</div>
                        <div class="notif-time">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </a>
            }
        </div>
    }
</div>


