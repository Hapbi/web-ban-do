@model List<CartLine>
@{ var total = Model.Sum(l => l.P.Price * l.Qty); }
<h1 class="pt">Giỏ hàng</h1>
@if (!Model.Any())
{
    <p class="muted">Giỏ hàng trống. <a href="/" style="color:var(--red)">Tiếp tục mua sắm</a></p>
}
else
{
    <p class="muted">@Model.Count sản phẩm đang chờ thanh toán</p>
    <div class="two">
        <div>
            @foreach (var l in Model)
            {
                <div class="row">
                    <div class="th">@if (!string.IsNullOrEmpty(l.P.ImageUrl)) { <img src="@l.P.ImageUrl" alt="" onerror="this.style.display='none'"> }</div>
                    <div class="info"><b>@l.P.Name</b><span>@l.P.Category • Còn @l.P.Stock</span></div>
                    <div class="rp">@((l.P.Price * l.Qty).Money())</div>
                    <div class="qty">
                        <form method="post" action="/Cart/Change" asp-antiforgery="true"><input type="hidden" name="id" value="@l.P.Id"><input type="hidden" name="delta" value="-1"><button>−</button></form>
                        <span>@l.Qty</span>
                        <form method="post" action="/Cart/Change" asp-antiforgery="true"><input type="hidden" name="id" value="@l.P.Id"><input type="hidden" name="delta" value="1"><button>+</button></form>
                    </div>
                </div>
            }
        </div>
        <div class="panel">
            <h3>Tóm tắt đơn hàng</h3>
            <div class="sl"><span>Tạm tính</span><b>@total.Money()</b></div>
            <div class="sl"><span>Phí giao hàng</span><b>Miễn phí</b></div>
            <div class="sl total"><span>Tổng cộng</span><b>@total.Money()</b></div>
            <a class="btn block" href="/Order/Checkout" style="margin-top:20px">Tiến hành thanh toán</a>
            <p class="note">Bạn có thể kiểm tra lại đơn hàng ở bước tiếp theo.</p>
        </div>
    </div>
}
