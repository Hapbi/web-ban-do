@inject NovaShop.Services.CartService CartSvc
@inject NovaShop.Services.AuthService AuthSvc
@inject NovaShop.Services.NotificationService NotifSvc
@inject NovaShop.Services.SettingsService ShopSettings
@{
    var cartCount = await CartSvc.GetCountAsync();
    var currentUser = await AuthSvc.GetCurrentAsync();
    var notifCount = currentUser != null ? await NotifSvc.UnreadCountAsync(currentUser.Id) : 0;
    var shop = await ShopSettings.GetSiteAsync();
    var currentPath = Context.Request.Path.Value ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")BTVH</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Apply theme before body renders to prevent flash
        (function() {
            const theme = localStorage.getItem('btvh-theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#main">Bỏ qua để đến nội dung chính</a>

    <header class="site-header" id="site-header">
        <div class="container header-inner">
            <a href="/" class="brand">
                <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
                    <rect width="36" height="36" rx="10" fill="url(#grad-logo)"/>
                    <path d="M10 22l4-8 4 6 3-4 5 8z" fill="#fff"/>
                    <circle cx="25" cy="11" r="2.5" fill="#fbbf24"/>
                    <defs>
                        <linearGradient id="grad-logo" x1="0" y1="0" x2="36" y2="36">
                            <stop offset="0" stop-color="#6366f1"/>
                            <stop offset="1" stop-color="#ec4899"/>
                        </linearGradient>
                    </defs>
                </svg>
                <span class="brand-text">BTVH</span>
            </a>

            <form class="search-bar" method="get" action="/san-pham" autocomplete="off">
                <input type="search" name="q" id="search-input" placeholder="Tìm tủ lạnh, máy giặt, điều hòa..." />
                <button type="submit" aria-label="Tìm kiếm">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.4-4.4"/></svg>
                </button>
                <div class="search-suggest" id="search-suggest"></div>
            </form>

            <div class="header-actions">
                <button class="icon-btn" id="theme-toggle" aria-label="Đổi giao diện">
                    <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                    <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
                </button>

                @if (currentUser != null)
                {
                    <a href="/thong-bao" class="icon-btn" aria-label="Thông báo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
                        @if (notifCount > 0) { <span class="icon-badge">@notifCount</span> }
                    </a>
                }

                <a href="/yeu-thich" class="icon-btn" aria-label="Yêu thích">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                </a>

                <a href="/gio-hang" class="icon-btn cart-btn" aria-label="Giỏ hàng">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 002 1.6h9.7a2 2 0 002-1.6L23 6H6"/></svg>
                    @if (cartCount > 0) { <span class="icon-badge">@cartCount</span> }
                </a>

                @if (currentUser != null)
                {
                    <div class="user-menu">
                        <button class="user-btn">
                            <span class="avatar">@currentUser.Avatar</span>
                            <span class="user-name">@currentUser.FullName</span>
                        </button>
                        <div class="user-dropdown">
                            <div class="dropdown-header">
                                <strong>@currentUser.FullName</strong>
                                <span>@currentUser.Email</span>
                            </div>
                            <a href="/tai-khoan">👤 Tài khoản</a>
                            <a href="/don-hang">📦 Đơn hàng của tôi</a>
                            <a href="/yeu-thich">❤️ Yêu thích</a>
                            <a href="/kenh-ban-hang">🛍️ Kênh bán hàng</a>
                            @if (currentUser.Role == "Admin") { <a href="/admin">⚙️ Trang quản trị</a><a href="/staff">👥 Khu vực nhân viên</a> }
                            @if (currentUser.Role == "Staff") { <a href="/staff">👥 Trang nhân viên</a> }
                            <form method="post" action="/dang-xuat">
                                <button type="submit">🚪 Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/dang-nhap" class="btn-login">Đăng nhập</a>
                }
            </div>
        </div>

        <nav class="cat-nav">
            <div class="container cat-nav-inner">
                <a href="/" class="@(currentPath == "/" ? "active" : "")">Trang chủ</a>
                <a href="/san-pham" class="@(currentPath.StartsWith("/san-pham") ? "active" : "")">Sản phẩm</a>
                <a href="/blog">Blog</a>
                <a href="/tra-cuu">Tra cứu đơn</a>
                <a href="/lien-he">Liên hệ</a>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="toast-container" id="toast-container">
            @if (TempData["Success"] != null)
            {
                <div class="toast toast-success">
                    <span class="toast-icon">✓</span>
                    <span class="toast-text">@TempData["Success"]</span>
                    <button class="toast-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="toast toast-error">
                    <span class="toast-icon">!</span>
                    <span class="toast-text">@TempData["Error"]</span>
                    <button class="toast-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }
        </div>
    }

    <main id="main" tabindex="-1">@RenderBody()</main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-col">
                <div class="brand footer-brand">
                    <svg width="36" height="36" viewBox="0 0 36 36"><rect width="36" height="36" rx="10" fill="url(#grad-logo2)"/><path d="M10 22l4-8 4 6 3-4 5 8z" fill="#fff"/><defs><linearGradient id="grad-logo2"><stop offset="0" stop-color="#6366f1"/><stop offset="1" stop-color="#ec4899"/></linearGradient></defs></svg>
                    <span class="brand-text">BTVH</span>
                </div>
                <p>@shop.Tagline</p>
                <form class="newsletter-form" method="post" action="/dang-ky-nhan-tin">
                    <input type="email" name="email" placeholder="Email nhận tin khuyến mãi" required />
                    <button type="submit">Đăng ký</button>
                </form>
            </div>
            <div class="footer-col">
                <h4>Danh mục</h4>
                <ul>
                    <li><a href="/san-pham?cat=tu-lanh">Tủ lạnh</a></li>
                    <li><a href="/san-pham?cat=may-giat">Máy giặt</a></li>
                    <li><a href="/san-pham?cat=dieu-hoa">Điều hòa</a></li>
                    <li><a href="/san-pham?cat=noi-com">Nồi cơm</a></li>
                    <li><a href="/san-pham?cat=may-hut-bui">Máy hút bụi</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Hỗ trợ</h4>
                <ul>
                    <li><a href="/tra-cuu">Tra cứu đơn hàng</a></li>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/lien-he">Liên hệ</a></li>
                    <li>Chính sách đổi trả 7 ngày</li>
                    <li>Bảo hành chính hãng</li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Liên hệ</h4>
                <ul>
                    <li>📞 @shop.Phone</li>
                    <li>✉️ @shop.Email</li>
                    <li>📍 @shop.Address</li>
                    <li>🕐 @shop.OpenHours</li>
                </ul>
                <div class="footer-social">
                    @if (!string.IsNullOrWhiteSpace(shop.FacebookUrl)) { <a href="@shop.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a> }
                    @if (!string.IsNullOrWhiteSpace(shop.ZaloUrl)) { <a href="@shop.ZaloUrl" target="_blank" rel="noopener noreferrer" aria-label="Zalo">Z</a> }
                    @if (!string.IsNullOrWhiteSpace(shop.YoutubeUrl)) { <a href="@shop.YoutubeUrl" target="_blank" rel="noopener noreferrer" aria-label="YouTube">▶</a> }
                </div>
            </div>
        </div>
        <div class="footer-bottom container">
            <span>© @DateTime.Now.Year BTVH. Demo website - không phục vụ mục đích kinh doanh thật.</span>
            <span>Made with ❤️ in Vietnam</span>
        </div>
    </footer>

    <button class="back-to-top" id="back-top" aria-label="Lên đầu trang">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>


