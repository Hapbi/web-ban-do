@inject CuaHangGiaDung.Data.AppDb Db
@{
    var st = Db.Settings.First();
    var cats = Db.Products.Where(p => !p.IsHidden).Select(p => p.Category).Where(c => c != null && c != "").Distinct().ToList();
    var n = CartHelper.Get(Context.Session).Values.Sum();
    var path = Context.Request.Path.Value.ToLower();
    var isManage = User.IsBackoffice() && path.StartsWith("/manage");
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var roleName = role == "Admin" ? "Quản trị viên" : "Staff";
    string Act(bool on) => on ? "on" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]@st.ShopName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true">
    @if (path.StartsWith("/manage/dashboard"))
    {
        <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">
    }
</head>
<body>
<header class="top"><div class="wrap">
    <a class="logo" href="/">@st.ShopName.ToUpper()</a>
    <form class="sbox" method="get" action="/Home/Products">
        <input name="q" placeholder="Tìm dụng cụ, thiết bị, đồ gia dụng..." value="@Context.Request.Query["q"]">
    </form>
    <div class="tools">
        @if (User.Identity.IsAuthenticated)
        {
            <div class="menu">
                <button type="button">@User.Identity.Name ▾</button>
                <div class="drop">
                    <div class="who">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                    <a href="/Order/My">Đơn hàng của tôi</a>
                    <a href="/Home/Favorites">Sản phẩm yêu thích</a>
                    @if (User.IsBackoffice()) { <a href="/Manage/Dashboard">Dashboard</a> }
                    @if (User.CanProducts()) { <a href="/Manage/Products">Quản lý sản phẩm</a> }
                    @if (User.Can("order.view")) { <a href="/Manage/Orders">Quản lý đơn hàng</a> }
                    @if (User.IsInRole("Admin")) { <a href="/Manage/Users">Tài khoản &amp; vai trò</a> }
                    @if (User.Can("settings.manage")) { <a href="/Manage/Settings">Cấu hình website/QR</a> }
                    <form method="post" action="/Account/Logout" asp-antiforgery="true"><button>Đăng xuất</button></form>
                </div>
            </div>
        }
        else
        {
            <div class="menu">
                <button type="button">Tài khoản ▾</button>
                <div class="drop"><a href="/Account/Login">Đăng nhập</a><a href="/Account/Register">Đăng ký</a></div>
            </div>
        }
        <a href="/Order/My">Đơn hàng</a>
        <a href="/Cart">🛒 @n</a>
    </div>
</div></header>
<nav class="catbar"><div class="wrap">
    <b>DANH MỤC</b>
    @foreach (var c in cats) { <a href="/Home/Products?cats=@Uri.EscapeDataString(c)">@c</a> }
    <span style="margin-left:auto"></span>
    <a href="/Home/Posts">Bài viết</a>
    <a href="/Home/Contact">Liên hệ / Phản ánh</a>
</div></nav>

<div class="promo-marquee" role="region" aria-label="Thông báo khuyến mãi">
    <div class="promo-marquee-track">
        <span>✦ GIA DỤNG TỐT — ƯU ĐÃI MỖI NGÀY</span><span>🚚 Giao hàng toàn quốc</span>
<span>⭐ Đánh giá từ khách hàng</span>
        <span>↻ Hỗ trợ đổi trả theo chính sách cửa hàng</span>
        <span>✦ GIA DỤNG TỐT — ƯU ĐÃI MỖI NGÀY</span><span>🚚 Giao hàng toàn quốc</span>
<span>⭐ Đánh giá từ khách hàng</span>
        <span>↻ Hỗ trợ đổi trả theo chính sách cửa hàng</span>
    </div>
</div>

@if (TempData["Msg"] != null || TempData["Err"] != null)
{
    <div class="toast-stack" id="siteToastStack" aria-live="polite" aria-atomic="true">
        @if (TempData["Msg"] != null)
        {
            <div class="site-toast site-toast-success" role="status">
                <span class="site-toast-icon" aria-hidden="true">✓</span>
                <div class="site-toast-copy">
                    <strong>Thành công</strong>
                    <span>@TempData["Msg"]</span>
                </div>
                <button type="button" class="site-toast-close" aria-label="Đóng thông báo">×</button>
                <span class="site-toast-progress"></span>
            </div>
        }
        @if (TempData["Err"] != null)
        {
            <div class="site-toast site-toast-error" role="alert">
                <span class="site-toast-icon" aria-hidden="true">!</span>
                <div class="site-toast-copy">
                    <strong>Có lỗi xảy ra</strong>
                    <span>@TempData["Err"]</span>
                </div>
                <button type="button" class="site-toast-close" aria-label="Đóng thông báo">×</button>
                <span class="site-toast-progress"></span>
            </div>
        }
    </div>
}

<div class="@(isManage ? "wrap mng" : "wrap")">
    @if (isManage)
    {
        <aside class="side">
            <div class="side-head"><b>@User.Identity.Name</b><span>@roleName</span></div>
            <a class="@Act(path == "/manage/dashboard" || path == "/manage")" href="/Manage/Dashboard">📊 Dashboard</a>
            @if (User.CanProducts())
            {
                <div class="side-grp">Sản phẩm</div>
                <a class="@Act(path == "/manage/products" || (path.StartsWith("/manage/productform/") ))" href="/Manage/Products">📦 Danh sách sản phẩm</a>
                <a class="@Act(path == "/manage/productform")" href="/Manage/ProductForm">➕ Thêm sản phẩm</a>
            }
            @if (User.Can("order.view"))
            {
                <div class="side-grp">Bán hàng</div>
                <a class="@Act(path == "/manage/orders")" href="/Manage/Orders">🧾 Đơn hàng</a>
            }
            @if (User.Can("post.manage") || User.Can("contact.manage"))
            {
                <div class="side-grp">Nội dung &amp; khách hàng</div>
                if (User.Can("post.manage")) { <a class="@Act(path.StartsWith("/manage/post"))" href="/Manage/Posts">📰 Bài viết</a> }
                if (User.Can("contact.manage")) { <a class="@Act(path == "/manage/contacts")" href="/Manage/Contacts">💬 Liên hệ &amp; phản ánh</a> }
            }
            @if (User.Can("report.view"))
            {
                <div class="side-grp">Báo cáo</div>
                <a class="@Act(path == "/manage/report")" href="/Manage/Report">📋 Báo cáo vận hành</a>
            }
            @if (User.Can("stats.view"))
            {
                if (!User.Can("report.view")) { <div class="side-grp">Báo cáo</div> }
                <a class="@Act(path.StartsWith("/manage/stats"))" href="/Manage/Stats">📈 Thống kê</a>
            }
            @if (User.Can("taxonomy.manage") || User.Can("banner.manage") || User.Can("settings.manage") || User.Can("log.view") || User.IsInRole("Admin"))
            {
                <div class="side-grp">Quản trị hệ thống</div>
                if (User.Can("taxonomy.manage")) { <a class="@Act(path == "/manage/taxonomy")" href="/Manage/Taxonomy">🏷️ Danh mục · Thương hiệu · Tag</a> }
                if (User.IsInRole("Admin")) { <a class="@Act(path == "/manage/users" || path.StartsWith("/manage/permissions"))" href="/Manage/Users">👥 Tài khoản &amp; phân quyền</a> }
                if (User.Can("banner.manage")) { <a class="@Act(path == "/manage/banners")" href="/Manage/Banners">🖼️ Banner</a> }
                if (User.Can("settings.manage")) { <a class="@Act(path == "/manage/settings")" href="/Manage/Settings">⚙️ Cấu hình website / QR</a> }
                if (User.Can("log.view")) { <a class="@Act(path == "/manage/systemlog")" href="/Manage/SystemLog">🕘 Nhật ký hệ thống</a> }
            }
            <div class="side-grp">Khác</div>
            <a href="/">🏠 Về cửa hàng</a>
            <form method="post" action="/Account/Logout" asp-antiforgery="true"><button>🚪 Đăng xuất</button></form>
        </aside>
    }
    <main class="@(isManage ? "mcontent" : "")">
        @RenderBody()
    </main>
</div>
<footer class="foot"><div class="wrap">
    <div><h4>@st.ShopName</h4><p>Đồ gia dụng chính hãng, giao hàng toàn quốc.</p></div>
    <div><h4>Liên hệ</h4><p>📍 @st.Address</p><p>📞 @st.Phone</p><p>✉️ @st.Email</p></div>
    <div><h4>Giờ mở cửa</h4><p>@st.OpenHours</p></div>
    <div><h4>Thanh toán</h4><p>@st.BankName - @st.AccountNo</p><p>@st.AccountHolder</p></div>
    <p class="copy">© @DateTime.Now.Year @st.ShopName. All rights reserved.</p>
</div></footer>
<script src="~/js/notifications.js" asp-append-version="true"></script>
<script src="~/js/site.js"></script>
</body>
</html>
