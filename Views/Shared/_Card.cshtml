@model Product
@{
    var fav = (HashSet<int>)ViewBag.Fav;
    var ret = Context.Request.Path + Context.Request.QueryString;
    var imageFallback = (
        ((Model.Name ?? "").Contains("robot", StringComparison.OrdinalIgnoreCase) ||
         (Model.Name ?? "").Contains("hút bụi", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/robot-vacuum.svg"
        : ((Model.Name ?? "").Contains("sấy tóc", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/hair-dryer.svg"
        : ((Model.Name ?? "").Contains("trái cây", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("ép", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("xay", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/fruit-juicer.svg"
        : ((Model.Name ?? "").Contains("khoan", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("dụng cụ", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("tua vít", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("kìm", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("búa", StringComparison.OrdinalIgnoreCase) ||
           (Model.Category ?? "").Contains("điện cầm tay", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/power-tool.svg"
        : ((Model.Name ?? "").Contains("nồi", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("bếp", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("gia dụng", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/kitchen-appliance.svg"
        : "/images/products/product-default.svg"
    );
    var imageSrc = string.IsNullOrWhiteSpace(Model.ImageUrl) ? imageFallback : Model.ImageUrl;
}
<div class="card">
    <form method="post" action="/Home/ToggleFav" asp-antiforgery="true">
        <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="returnUrl" value="@ret">
        <button class="heart @(fav.Contains(Model.Id) ? "on" : "")" title="Yêu thích">♥</button>
    </form>
    <div class="product-card-visual">
        <a class="img" href="@Url.Action("Detail", "Home", new { id = Model.Id })">
            <img src="@imageSrc" alt="@Model.Name" data-fallback="@imageFallback" onerror="this.onerror=null;this.src=this.dataset.fallback || '/images/products/product-default.svg'">
        </a>
        <div class="card-hover-details">
            <span class="card-hover-label">THÔNG TIN SẢN PHẨM</span>
            <strong>@Model.Name</strong>
            <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Sản phẩm gia dụng tiện ích cho gia đình." : Model.Description)</p>
            @if (!string.IsNullOrWhiteSpace(Model.DetailedConfiguration))
            {
                <div class="card-hover-spec">
                    @foreach (var line in Model.DetailedConfiguration.Split('\n', StringSplitOptions.RemoveEmptyEntries).Take(2))
                    {
                        <span>@line</span>
                    }
                </div>
            }
            <a class="card-hover-link" href="@Url.Action("Detail", "Home", new { id = Model.Id })">Xem thông tin chi tiết <span>→</span></a>
        </div>
    </div>
    <h3><a href="@Url.Action("Detail", "Home", new { id = Model.Id })">@Model.Name</a></h3>
    <div class="product-card-rating" aria-label="Đánh giá sản phẩm">
        <span class="rating-stars" aria-hidden="true">@for (var s = 1; s <= 5; s++) { <span class="@(s <= Math.Round(Model.AverageRating) ? "filled" : "")">★</span> }</span>
        @if (Model.ReviewCount > 0)
        {
            <span class="rating-score">@Model.AverageRating.ToString("0.0")</span>
            <span class="rating-count">(@Model.ReviewCount đánh giá)</span>
        }
        else
        {
            <span class="rating-count">Chưa có đánh giá</span>
        }
    </div>
    <div class="price">@Model.Price.Money()</div>
    <div class="product-detail-hint">Xem thông tin &amp; đánh giá</div>
    <div class="sub">Miễn phí đổi trả 7 ngày</div>
    @if (Model.Stock > 0)
    {
        <form method="post" action="/Cart/Add" style="margin-top:auto" asp-antiforgery="true">
            <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="returnUrl" value="@ret">
            <button class="btn-o btn-s block">Thêm vào giỏ</button>
        </form>
    }
    else { <span class="muted">Hết hàng</span> }
</div>
