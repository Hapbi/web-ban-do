@{
    Layout = null;
    var active = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAdmin = User.IsInRole("Admin");
    var inStaffArea = string.Equals(controller, "Staff", StringComparison.OrdinalIgnoreCase);
    var currentUser = User.Identity?.Name;
    bool Active(string ctrl, string act = "") =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
        && (string.IsNullOrEmpty(act) || string.Equals(active, act, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")@(inStaffArea ? "Nhân viên" : "Quản trị") - BTVH</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <header class="admin-topbar">
        <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <a href="/" class="admin-brand">✦ BTVH</a>
        <div class="topbar-right">
            <a href="/" target="_blank" class="topbar-link">Xem website ↗</a>
            <span class="topbar-user">👤 @currentUser</span>
            <form method="post" action="/dang-xuat" style="display:inline">
                <button type="submit" class="topbar-logout">Đăng xuất</button>
            </form>
        </div>
    </header>

    <div class="admin-shell">
        <aside class="admin-sidebar" id="admin-sidebar">
            <div class="sidebar-section">
                <span class="role-badge">@(isAdmin ? (inStaffArea ? "Quản trị viên · khu vực nhân viên" : "Quản trị viên") : "Nhân viên")</span>
            </div>

            @if (isAdmin && !inStaffArea)
            {
                <div class="sidebar-section">
                    <a href="/admin" class="sidebar-link @(Active("Admin", "Index") ? "active" : "")">📊 Dashboard</a>
                </div>
                <div class="sidebar-group">Sản phẩm & kho</div>
                <a href="/admin/san-pham" class="sidebar-link @(Active("Admin", "Products") || Active("Admin", "ProductEdit") ? "active" : "")">📦 Quản lý sản phẩm</a>
                <a href="/admin/danh-muc" class="sidebar-link @(Active("Admin", "Categories") ? "active" : "")">🗂️ Danh mục</a>
                <a href="/admin/thuong-hieu" class="sidebar-link @(Active("Admin", "Brands") ? "active" : "")">🏷️ Thương hiệu</a>
                <a href="/admin/the-san-pham" class="sidebar-link @(Active("Admin", "Tags") ? "active" : "")">🔖 Thẻ sản phẩm</a>
                <a href="/admin/ton-kho" class="sidebar-link @(Active("Admin", "Inventory") ? "active" : "")">📦 Tồn kho</a>
                <a href="/admin/danh-gia" class="sidebar-link @(Active("Admin", "Reviews") ? "active" : "")">⭐ Đánh giá</a>
                <a href="/admin/marketplace" class="sidebar-link @(Active("Admin", "Marketplace") ? "active" : "")">🛍️ Marketplace</a>
                <div class="sidebar-group">Bán hàng</div>
                <a href="/admin/don-hang" class="sidebar-link @(Active("Admin", "Orders") || Active("Admin", "OrderDetail") ? "active" : "")">🧾 Đơn hàng</a>
                <a href="/admin/thanh-toan" class="sidebar-link @(Active("Admin", "Payments") ? "active" : "")">💳 Xác minh thanh toán</a>
                <a href="/admin/ma-giam-gia" class="sidebar-link @(Active("Admin", "Coupons") ? "active" : "")">🎟️ Mã giảm giá</a>
                <a href="/admin/bao-cao/van-hanh" class="sidebar-link @(Active("Admin", "OperationsReport") ? "active" : "")">📋 Báo cáo vận hành</a>
                <a href="/admin/bao-cao/doanh-thu" class="sidebar-link @(Active("Admin", "RevenueReport") ? "active" : "")">📈 Doanh thu</a>
                <div class="sidebar-group">Nội dung</div>
                <a href="/admin/blog" class="sidebar-link @(Active("Admin", "Blog") || Active("Admin", "BlogEdit") ? "active" : "")">📝 Bài viết</a>
                <a href="/admin/banner" class="sidebar-link @(Active("Admin", "Banners") ? "active" : "")">🖼️ Banner</a>
                <a href="/admin/tin-nhan" class="sidebar-link @(Active("Admin", "Messages") ? "active" : "")">💬 Tin nhắn</a>
                <div class="sidebar-group">Hệ thống</div>
                <a href="/admin/nguoi-dung" class="sidebar-link @(Active("Admin", "Users") ? "active" : "")">👥 Người dùng & quyền</a>
                <a href="/admin/cau-hinh" class="sidebar-link @(Active("Admin", "Settings") ? "active" : "")">⚙️ Cấu hình cửa hàng</a>
                <a href="/admin/nhat-ky" class="sidebar-link @(Active("Admin", "AuditLogs") ? "active" : "")">🧾 Nhật ký thao tác</a>
                <a href="/staff" class="sidebar-link">👨‍💼 Khu vực nhân viên</a>
            }
            else
            {
                <div class="sidebar-section">
                    <a href="/staff" class="sidebar-link @(Active("Staff", "Index") ? "active" : "")">📊 Dashboard</a>
                </div>
                <div class="sidebar-group">Đơn hàng & xử lý</div>
                <a href="/staff/don-hang" class="sidebar-link @(Active("Staff", "Orders") || Active("Staff", "OrderDetail") ? "active" : "")">🧾 Tất cả đơn hàng</a>
                <a href="/staff/kanban" class="sidebar-link @(Active("Staff", "Kanban") ? "active" : "")">🎯 Kanban Board</a>
                @if (User.IsInRole("Admin") || User.HasClaim("CanVerifyPayments", "true"))
                {
                    <a href="/staff/thanh-toan" class="sidebar-link @(Active("Staff", "Payments") ? "active" : "")">💳 Xác minh thanh toán</a>
                }
                <a href="/staff/ton-kho" class="sidebar-link @(Active("Staff", "Inventory") ? "active" : "")">📦 Tình hình tồn kho</a>
            }

            <div class="sidebar-footer">
                @if (isAdmin && inStaffArea) { <a href="/admin">← Về quản trị</a> }
                <a href="/">← Về trang chủ</a>
            </div>
        </aside>

        <main class="admin-main">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <div class="toast-container" id="toast-container"></div>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>


