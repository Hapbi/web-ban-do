@model SellerCreateVM
@{ ViewData["Title"] = Model.Id > 0 ? "Sửa tin đăng" : "Đăng sản phẩm"; }
<div class="container seller-page">
    <a href="/kenh-ban-hang" class="back-link">← Về gian hàng</a>
    <header class="seller-hero"><div><span class="eyebrow">BTVH MARKETPLACE</span><h1>@(Model.Id > 0 ? "Cập nhật tin đăng" : "Đăng sản phẩm mới")</h1><p>Sản phẩm sẽ được ẩn khỏi catalog cho đến khi Admin duyệt.</p></div></header>
    <form method="post" action="/kenh-ban-hang/luu" class="seller-form dash-panel" enctype="multipart/form-data">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-row-2"><div class="form-group"><label asp-for="Name">Tên sản phẩm</label><input asp-for="Name" required minlength="3"/><span asp-validation-for="Name" class="field-error"></span></div><div class="form-group"><label asp-for="Brand">Thương hiệu</label><select asp-for="Brand" required><option value="">Chọn thương hiệu</option>@foreach(var b in Model.Brands){<option value="@b.Name" selected="@(Model.Brand==b.Name)">@b.Name</option>}</select><span asp-validation-for="Brand" class="field-error"></span></div></div>
        <div class="form-row-2"><div class="form-group"><label asp-for="CategoryId">Danh mục</label><select asp-for="CategoryId" required><option value="0">Chọn danh mục</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Icon @c.Name</option>}</select><span asp-validation-for="CategoryId" class="field-error"></span></div><div class="form-group"><label asp-for="Price">Giá bán (VND)</label><input asp-for="Price" type="number" min="1" step="1000" required/><span asp-validation-for="Price" class="field-error"></span></div></div>
        <div class="form-row-2"><div class="form-group"><label asp-for="Stock">Số lượng</label><input asp-for="Stock" type="number" min="1" max="10000" required/><span asp-validation-for="Stock" class="field-error"></span></div><div class="form-group"><label asp-for="ImageUrl">Ảnh sản phẩm (tùy chọn)</label><input asp-for="ImageUrl" placeholder="/images/products/fallback.svg hoặc https://..."/><span asp-validation-for="ImageUrl" class="field-error"></span><label asp-for="ImageFile">Hoặc tải ảnh từ máy</label><input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif"/><span asp-validation-for="ImageFile" class="field-error"></span><p class="muted small">JPG/PNG/WEBP/GIF, tối đa 5 MB. Ảnh được lưu trong website.</p></div></div>
        <div class="form-group"><label asp-for="Description">Mô tả / tình trạng sản phẩm</label><textarea asp-for="Description" rows="6" minlength="20" required placeholder="Mô tả tình trạng, kích thước, phụ kiện, bảo hành..."></textarea><span asp-validation-for="Description" class="field-error"></span></div>
        <div class="seller-form-note"><strong>Quy trình:</strong> gửi tin → Admin kiểm tra → nếu được duyệt, sản phẩm mới xuất hiện trong cửa hàng. Hãy đảm bảo ảnh, giá và mô tả đúng thực tế.</div>
        <button class="btn-primary" type="submit">@(Model.Id > 0 ? "Gửi lại để duyệt" : "Gửi sản phẩm để duyệt")</button>
    </form>
</div>
