@model List<Product>
@if (ViewBag.Banners != null && ((List<Banner>)ViewBag.Banners).Count > 0)
{
    <div class="banners">
        @foreach (var b in (List<Banner>)ViewBag.Banners)
        {
            if (!string.IsNullOrEmpty(b.LinkUrl)) { <a href="@b.LinkUrl" class="banner"><img src="@b.ImageUrl" alt="@b.Title" onerror="this.style.display='none'"></a> }
            else { <div class="banner"><img src="@b.ImageUrl" alt="@b.Title" onerror="this.style.display='none'"></div> }
        }
    </div>
}
else
{
    <section class="hero">
        <h1>ĐỒ GIA DỤNG</h1>
        <p>Dụng cụ bền chắc • Thiết bị tiện ích • Giá tốt mỗi ngày</p>
        <a class="btn-w" href="/Home/Products">XEM SẢN PHẨM</a>
    </section>
}
<h2 class="sec">Sản phẩm nổi bật</h2>
<div class="grid">
    @foreach (var p in Model) { <partial name="_Card" model="p" /> }
</div>
<h2 class="sec">Danh mục tiện ích</h2>
<div class="cats">
    @foreach (CatInfo c in ViewBag.Cats)
    {
        <a class="cat" href="/Home/Products?cats=@Uri.EscapeDataString(c.Name)"><b>@c.Name</b><span>@c.Count sản phẩm</span></a>
    }
</div>
