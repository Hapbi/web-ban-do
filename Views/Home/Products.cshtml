@model ProductsVm
@{ ViewData["Title"] = "Tìm kiếm - "; }
<h1 class="pt">Tìm kiếm sản phẩm</h1>
<div class="sres">
    <form class="filter" method="get" action="/Home/Products">
        <input type="hidden" name="q" value="@Model.Q">
        <h3>Bộ lọc</h3>
        <h4>Danh mục</h4>
        @foreach (var c in Model.Cats)
        {
            <label><input type="checkbox" name="cats" value="@c" checked="@Model.SelCats.Contains(c)" data-autosubmit> @c</label>
        }
        <h4>Khoảng giá</h4>
        @foreach (var (k, l) in new[] { ("a", "Dưới 500.000đ"), ("b", "500.000–1.000.000đ"), ("c", "Trên 1.000.000đ") })
        {
            <label><input type="checkbox" name="prices" value="@k" checked="@Model.SelPrices.Contains(k)" data-autosubmit> @l</label>
        }
    </form>
    <div>
        <h2 class="sec">@Model.Items.Count kết quả</h2>
        <div class="grid">
            @foreach (var p in Model.Items) { <partial name="_Card" model="p" /> }
        </div>
        @if (Model.Items.Count == 0) { <p class="muted">Không tìm thấy sản phẩm phù hợp.</p> }
    </div>
</div>
