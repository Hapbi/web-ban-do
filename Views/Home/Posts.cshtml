@model List<Post>
@{ ViewData["Title"] = "Bài viết - "; }
<h1 class="pt">Bài viết</h1>
<div class="grid">
    @foreach (var p in Model)
    {
        <div class="card">
            @if (!string.IsNullOrEmpty(p.ImageUrl)) { <a class="img" href="/Home/Post/@p.Id"><img src="@p.ImageUrl" alt="@p.Title" onerror="this.style.display='none'"></a> }
            <h3><a href="/Home/Post/@p.Id">@p.Title</a></h3>
            <div class="sub">@p.Created.ToString("dd/MM/yyyy")</div>
            <p class="muted">@p.Summary</p>
        </div>
    }
</div>
@if (Model.Count == 0) { <p class="muted">Chưa có bài viết nào.</p> }
