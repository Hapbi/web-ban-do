@model Product
@{
    ViewData["Title"] = Model.Name + " - ";
    var fav = (HashSet<int>)ViewBag.Fav;
    var ret = Context.Request.Path + Context.Request.QueryString;
    var reviews = ViewBag.Reviews as List<ProductReview> ?? new List<ProductReview>();
    var avgRating = (double)(ViewBag.AverageRating ?? 0.0);
    var reviewCount = (int)(ViewBag.ReviewCount ?? 0);
    var imageFallback = (
        ((Model.Name ?? "").Contains("robot", StringComparison.OrdinalIgnoreCase) ||
         (Model.Name ?? "").Contains("hút bụi", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/robot-vacuum.svg"
        : ((Model.Name ?? "").Contains("sấy tóc", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/hair-dryer.svg"
        : ((Model.Name ?? "").Contains("trái cây", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("ép", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("xay", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/fruit-juicer.svg"
        : ((Model.Name ?? "").Contains("khoan", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("dụng cụ", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("tua vít", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("kìm", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("búa", StringComparison.OrdinalIgnoreCase) ||
           (Model.Category ?? "").Contains("điện cầm tay", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/power-tool.svg"
        : ((Model.Name ?? "").Contains("nồi", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("bếp", StringComparison.OrdinalIgnoreCase) ||
           (Model.Name ?? "").Contains("gia dụng", StringComparison.OrdinalIgnoreCase))
            ? "/images/products/kitchen-appliance.svg"
        : "/images/products/product-default.svg"
    );
    var imageSrc = string.IsNullOrWhiteSpace(Model.ImageUrl) ? imageFallback : Model.ImageUrl;
}
<div class="crumb"><a href="/">Trang chủ</a> / <a href="/Home/Products?cats=@Uri.EscapeDataString(Model.Category ?? "")">@Model.Category</a> / @Model.Name</div>
<div class="detail">
    <div class="pimg">
        <form method="post" action="/Home/ToggleFav" asp-antiforgery="true">
            <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="returnUrl" value="@ret">
            <button class="heart @(fav.Contains(Model.Id) ? "on" : "")">♥</button>
        </form>
        <div class="in">
            <img src="@imageSrc" alt="@Model.Name" data-fallback="@imageFallback" onerror="this.onerror=null;this.src=this.dataset.fallback || '/images/products/product-default.svg'">
        </div>
    </div>
    <div>
        <h1>@Model.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Brand) || !string.IsNullOrEmpty(Model.Tags))
        {
            <p class="muted">
                @if (!string.IsNullOrEmpty(Model.Brand)) { <span>Thương hiệu: <b>@Model.Brand</b></span> }
                @foreach (var t in (Model.Tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <span class="tag tag-off">#@t</span> }
            </p>
        }
        <div class="detail-rating">
            <span class="rating-stars">@for (var s = 1; s <= 5; s++) { <span class="@(s <= Math.Round(avgRating) ? "filled" : "")">★</span> }</span>
            <b>@(reviewCount == 0 ? "Chưa có đánh giá" : avgRating.ToString("0.0") + "/5")</b>
            <a href="#reviews">(@reviewCount bình luận)</a>
        </div>
        <div class="bigprice">@Model.Price.Money()</div>
        <h4>Mô tả sản phẩm</h4>
        @foreach (var line in (Model.Description ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <p>• @line</p> }
        <p class="muted">Còn lại: @Model.Stock sản phẩm</p>
        @if (Model.Stock > 0)
        {
            <div class="acts">
                <form method="post" action="/Cart/Add" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="returnUrl" value="@ret">
                    <button class="btn-o block">Thêm vào giỏ</button>
                </form>
                <form method="post" action="/Cart/Add" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="buy" value="true">
                    <button class="btn block">Mua ngay</button>
                </form>
            </div>
        }
        else { <p><b>Hết hàng</b></p> }
        <div class="pledge"><b>Cam kết mua sắm</b><span>Giao hàng toàn quốc • Kiểm tra khi nhận • Đổi trả 7 ngày</span></div>
    </div>
</div>


<section class="product-info-section">
    <div class="product-info-heading">
        <span class="product-info-icon">⚙</span>
        <div><h2>Thông tin chi tiết</h2><p>Mô tả và thông số của sản phẩm</p></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.DetailedConfiguration))
    {
        <div class="spec-list">
            @foreach (var line in Model.DetailedConfiguration.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = line.Split(':', 2);
                <div class="spec-row">
                    <span>@(parts.Length > 1 ? parts[0].Trim() : "Thông tin")</span>
                    <b>@(parts.Length > 1 ? parts[1].Trim() : parts[0].Trim())</b>
                </div>
            }
        </div>
    }
    else { <p class="muted">Cửa hàng chưa cập nhật thông tin chi tiết cho sản phẩm này.</p> }
</section>

<section class="product-info-section" id="reviews">
    <div class="product-info-heading">
        <span class="product-info-icon review-icon">★</span>
        <div><h2>Đánh giá &amp; bình luận</h2><p>Chia sẻ trải nghiệm của bạn về sản phẩm</p></div>
    </div>
    <div class="review-summary">
        <strong>@(reviewCount == 0 ? "—" : avgRating.ToString("0.0"))</strong>
        <div><div class="rating-stars large">@for (var s = 1; s <= 5; s++) { <span class="@(s <= Math.Round(avgRating) ? "filled" : "")">★</span> }</div><span>@reviewCount đánh giá</span></div>
    </div>
    <form class="review-form" method="post" action="/Home/AddReview" asp-antiforgery="true">
        <input type="hidden" name="productId" value="@Model.Id">
        <h3>Viết đánh giá của bạn</h3>
        <label for="customerName">Tên hiển thị</label>
        <input id="customerName" name="customerName" maxlength="80" required placeholder="Nhập tên của bạn">
        <label>Chọn số sao</label>
        <div class="star-picker" role="radiogroup" aria-label="Chọn số sao">
            @for (var s = 5; s >= 1; s--)
            {
                <input type="radio" id="rating-@s" name="rating" value="@s" required>
                <label for="rating-@s" title="@s sao">★</label>
            }
        </div>
        <label for="comment">Bình luận</label>
        <textarea id="comment" name="comment" rows="4" maxlength="1200" required placeholder="Sản phẩm có tốt không? Hãy chia sẻ trải nghiệm..."></textarea>
        <button class="btn" type="submit">Gửi đánh giá</button>
    </form>
    <div class="review-list">
        @if (reviews.Count == 0)
        {
            <div class="review-empty"><span>☆</span><b>Chưa có bình luận nào</b><p>Hãy là người đầu tiên đánh giá sản phẩm này.</p></div>
        }
        else
        {
            @foreach (var review in reviews)
            {
                <article class="review-item">
                    <div class="review-avatar">@((string.IsNullOrWhiteSpace(review.CustomerName) ? "K" : review.CustomerName.Trim()[0].ToString().ToUpperInvariant()))</div>
                    <div class="review-body">
                        <div class="review-meta"><b>@review.CustomerName</b><time>@review.Created.ToString("dd/MM/yyyy HH:mm")</time></div>
                        <div class="rating-stars">@for (var s = 1; s <= 5; s++) { <span class="@(s <= review.Rating ? "filled" : "")">★</span> }</div>
                        <p>@review.Comment</p>
                    </div>
                </article>
            }
        }
    </div>
</section>
