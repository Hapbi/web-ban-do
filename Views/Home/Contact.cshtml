@{ ViewData["Title"] = "Liên hệ & phản ánh - "; }
<div class="box wide">
    <h2>Liên hệ / Phản ánh</h2>
    <p class="muted">Gửi câu hỏi hoặc phản ánh về sản phẩm, dịch vụ. Nhân viên sẽ xử lý và phản hồi bạn.</p>
    <form method="post" asp-antiforgery="true">
        <label>Loại</label>
        <select name="type">@foreach (var t in ContactSts.Types) { <option>@t</option> }</select>
        <label>Họ tên</label><input name="name" required maxlength="100">
        <label>Email</label><input name="email" type="email" maxlength="150">
        <label>Số điện thoại</label><input name="phone" maxlength="30">
        <label>Nội dung</label><textarea name="message" rows="5" required maxlength="2000"></textarea>
        <div style="margin-top:16px"><button class="btn">Gửi</button></div>
    </form>
</div>
