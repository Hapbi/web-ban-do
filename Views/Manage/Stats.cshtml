@model StatsVm
@{
    ViewData["Title"] = "Thống kê - ";
    var max = Model.Days.Count == 0 ? 0 : Model.Days.Max(d => d.Amount);
    var maxCat = Model.ByCat.Count == 0 ? 0 : Model.ByCat.Max(c => c.Amount);
}
<h1 class="pt">Thống kê</h1>
<form method="get" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin:10px 0">
    <div><label>Từ ngày</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"></div>
    <div><label>Đến ngày</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"></div>
    <button class="btn">Xem</button>
    <a class="btn btn-g" href="/Manage/StatsCsv?from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")">⬇ Xuất CSV</a>
</form>

<h2 class="sec">Doanh thu</h2>
<div class="kpis">
    <div class="kpi"><span>Doanh thu (đơn đã thanh toán)</span><b>@Model.Revenue.Money()</b></div>
    <div class="kpi"><span>Số đơn</span><b>@Model.Orders</b></div>
    <div class="kpi"><span>Giá trị TB / đơn</span><b>@((Model.Orders == 0 ? 0m : Math.Round(Model.Revenue / Model.Orders)).Money())</b></div>
    <div class="kpi bad"><span>Đơn đã hủy</span><b>@Model.Cancelled</b></div>
</div>
<div class="scroll" style="max-height:340px;overflow-y:auto"><table>
    <tr><th>Ngày</th><th>Số đơn</th><th>Doanh thu</th><th style="width:40%"></th></tr>
    @foreach (var d in Model.Days)
    {
        <tr>
            <td>@d.Day.ToString("dd/MM/yyyy")</td><td>@d.Orders</td><td>@d.Amount.Money()</td>
            <td><div style="background:var(--red);height:10px;border-radius:5px;width:@(max == 0 ? 0 : (int)Math.Round(d.Amount / max * 100))%"></div></td>
        </tr>
    }
</table></div>

<div class="dash2" style="margin-top:16px">
    <div class="panel">
        <h3>Sản phẩm bán chạy (top 10)</h3>
        @if (Model.Top.Count == 0) { <p class="muted">Chưa có dữ liệu trong khoảng này.</p> }
        else
        {
            <table class="kv">
                <tr><th>Sản phẩm</th><th>SL bán</th><th>Doanh thu</th></tr>
                @foreach (var t in Model.Top) { <tr><td>@t.Name</td><td>x@t.Qty</td><td>@t.Amount.Money()</td></tr> }
            </table>
        }
    </div>
    <div class="panel">
        <h3>Doanh thu theo danh mục</h3>
        @if (Model.ByCat.Count == 0) { <p class="muted">Chưa có dữ liệu.</p> }
        else
        {
            <table class="kv">
                @foreach (var c in Model.ByCat)
                {
                    <tr><td>@c.Category</td><td>@c.Amount.Money()</td></tr>
                }
            </table>
        }
    </div>
</div>

<h2 class="sec">Tồn kho</h2>
<div class="kpis">
    <div class="kpi"><span>Còn hàng</span><b>@Model.InStock</b></div>
    <div class="kpi warn"><span>Sắp hết (≤ 5)</span><b>@Model.Low</b></div>
    <div class="kpi bad"><span>Hết hàng</span><b>@Model.Out</b></div>
    <div class="kpi"><span>Đang ẩn</span><b>@Model.Hidden</b></div>
</div>
<div class="scroll"><table>
    <tr><th>Sản phẩm cần nhập thêm</th><th>Danh mục</th><th>Tồn kho</th></tr>
    @foreach (var p in Model.LowStock)
    {
        <tr><td>@p.Name @if (p.IsHidden) { <span class="tag tag-off">Đã ẩn</span> }</td><td>@p.Category</td><td><b>@p.Stock</b></td></tr>
    }
    @if (Model.LowStock.Count == 0) { <tr><td colspan="3" class="muted">Tồn kho đều ổn.</td></tr> }
</table></div>
