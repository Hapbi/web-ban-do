@model Product
@{
    var cats = (List<string>)ViewBag.Categories;
    var brands = (List<string>)ViewBag.Brands;
    var tagList = (List<string>)ViewBag.TagList;
    var haveTags = (Model.Tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var canPrice = Model.Id == 0 || User.Can("price.set");
}
<div class="box wide">
    <h2>@(Model.Id == 0 ? "Thêm" : "Sửa") sản phẩm</h2>
    <div asp-validation-summary="All" style="color:var(--red)"></div>
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id">
        <label>Tên</label><input asp-for="Name" required>
        <label>Danh mục</label>
        <select name="Category">
            <option value="">— Chọn danh mục —</option>
            @foreach (var c in cats) { <option value="@c" selected="@(c == Model.Category)">@c</option> }
            @if (!string.IsNullOrEmpty(Model.Category) && !cats.Contains(Model.Category)) { <option value="@Model.Category" selected>@Model.Category (cũ)</option> }
        </select>
        <label>Thương hiệu</label>
        <select name="Brand">
            <option value="">— Không chọn —</option>
            @foreach (var b in brands) { <option value="@b" selected="@(b == Model.Brand)">@b</option> }
            @if (!string.IsNullOrEmpty(Model.Brand) && !brands.Contains(Model.Brand)) { <option value="@Model.Brand" selected>@Model.Brand (cũ)</option> }
        </select>
        <label>Tag</label>
        <div>
            @foreach (var t in tagList)
            {
                <label style="display:inline-flex;align-items:center;gap:6px;margin:4px 14px 4px 0">
                    <input type="checkbox" name="tagList" value="@t" checked="@haveTags.Contains(t)" style="width:auto;margin:0"> @t
                </label>
            }
            @if (tagList.Count == 0) { <span class="muted">Chưa có tag nào (Admin tạo ở mục Danh mục / Thương hiệu / Tag).</span> }
        </div>
        <label>Giá (VNĐ)</label><input name="Price" type="text" inputmode="numeric" data-money placeholder="VD: 1.290.000" readonly="@(!canPrice)" title="@(canPrice ? "" : "Chỉ Admin được đổi giá")" value="@(Model.Price == 0 ? "" : ((long)Model.Price).ToString())">
        <label>Tồn kho</label><input asp-for="Stock" type="number" min="0">
        <label>Link ảnh (URL hoặc đường dẫn ảnh đã tải lên)</label>
        <input asp-for="ImageUrl" id="ImageUrl" placeholder="https://... hoặc /uploads/products/..." />
        <div class="field browser-image-picker">
            <label for="imageFile">Hoặc tải ảnh từ máy tính</label>
            <input type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.gif,image/*">
            <small class="muted">Ảnh tải lên sẽ lưu thành file trong wwwroot/uploads/products; database chỉ lưu đường dẫn. Tối đa 5 MB.</small>
            <div class="browser-image-preview-wrap" id="imagePreviewWrap" style="display:@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "none" : "block")">
                <img id="imagePreview" src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "" : Model.ImageUrl)" alt="Xem trước ảnh sản phẩm" onerror="this.style.display='none'">
            </div>
            <label style="display:flex;align-items:center;gap:8px;margin-top:8px">
                <input type="checkbox" name="removeImage" value="true" style="width:auto;margin:0"> Xóa ảnh hiện tại
            </label>
        </div>
        <label>Mô tả sản phẩm</label><textarea asp-for="Description" rows="4" placeholder="Mô tả ngắn, công dụng, bảo hành..."></textarea>
        <label>Thông tin chi tiết</label>
        <textarea asp-for="DetailedConfiguration" rows="7" placeholder="Công suất: 1800W&#10;Điện áp: 220V&#10;Chất liệu: Inox&#10;Bảo hành: 12 tháng"></textarea>
        <small class="muted">Mỗi dòng là một thông số. Nội dung sẽ hiển thị trong mục “Thông tin chi tiết” ở trang sản phẩm.</small>
        <div style="margin-top:16px"><button class="btn">Lưu</button> <a class="btn btn-g" href="/Manage/Products">Hủy</a></div>


<script>
(() => {
    const input = document.getElementById('imageFile');
    const preview = document.getElementById('imagePreview');
    const wrap = document.getElementById('imagePreviewWrap');
    const urlInput = document.getElementById('ImageUrl');
    if (!input || !preview || !wrap) return;
    let objectUrl = null;
    input.addEventListener('change', () => {
        const file = input.files && input.files[0];
        if (!file) return;
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        objectUrl = URL.createObjectURL(file);
        preview.src = objectUrl;
        preview.style.display = 'block';
        wrap.style.display = 'block';
    });
    urlInput?.addEventListener('input', () => {
        if (input.files && input.files.length) return;
        preview.src = urlInput.value;
        preview.style.display = urlInput.value ? 'block' : 'none';
        wrap.style.display = urlInput.value ? 'block' : 'none';
    });
    window.addEventListener('beforeunload', () => { if (objectUrl) URL.revokeObjectURL(objectUrl); });
})();
</script>

</form>
</div>
