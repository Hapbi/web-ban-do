@model List<Product>
<h1 class="pt">Quản lý sản phẩm</h1>
<a class="btn" href="/Manage/ProductForm">+ Thêm sản phẩm</a>
<div class="scroll"><table>
    <tr><th>ID</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Kho</th><th>Trạng thái</th><th></th></tr>
    @foreach (var p in Model)
    {
        <tr class="@(p.IsHidden ? "row-off" : "")">
            <td>@p.Id</td><td>@p.Name</td><td>@p.Category</td>
            <td>
                @if (User.Can("price.set"))
                {
                    <form method="post" action="/Manage/SetPrice" class="priceform" asp-antiforgery="true">
                        <input type="hidden" name="id" value="@p.Id">
                        <input name="price" type="text" inputmode="numeric" data-money value="@((long)p.Price)" aria-label="Giá">
                        <button class="btn btn-s">Lưu giá</button>
                    </form>
                }
                else { <text>@p.Price.Money()</text> }
            </td>
            <td>@p.Stock</td>
            <td>@if (p.IsHidden) { <span class="tag tag-off">Đã ẩn</span> } else { <span class="tag tag-ok">Đang bán</span> }</td>
            <td>
                <a class="btn btn-s" href="/Manage/ProductForm/@p.Id">Sửa</a>
                <form method="post" action="/Manage/ToggleHide" class="inline" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@p.Id">
                    @if (p.IsHidden) { <button class="btn btn-s">Khôi phục</button> }
                    else { <button class="btn btn-s btn-d">Ẩn</button> }
                </form>
                @if (User.Can("product.delete"))
                {
                <form method="post" action="/Manage/DeleteProduct" class="inline" data-confirm="Xóa vĩnh viễn '@p.Name'? Không thể hoàn tác (nếu chỉ muốn tạm ngưng bán, hãy dùng Ẩn)." asp-antiforgery="true">
                    <input type="hidden" name="id" value="@p.Id"><button class="btn btn-s btn-d">Xóa</button>
                </form>
                }
            </td>
        </tr>
    }
</table></div>
