@model List<AuditLog>
<h1 class="pt">Nhật ký hệ thống</h1>
<p class="muted">Ghi lại các thao tác quản trị (500 dòng gần nhất).</p>
<form method="get" style="display:flex;gap:10px;max-width:460px;margin:10px 0">
    <input name="q" value="@ViewBag.Q" placeholder="Tìm theo người làm, thao tác, nội dung...">
    <button class="btn">Tìm</button>
</form>
<div class="scroll"><table>
    <tr><th>Thời gian</th><th>Người thực hiện</th><th>Thao tác</th><th>Chi tiết</th></tr>
    @foreach (var a in Model)
    {
        <tr><td>@a.Time.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@a.UserEmail</td><td><b>@a.Action</b></td><td>@a.Detail</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="4" class="muted">Chưa có nhật ký.</td></tr> }
</table></div>
