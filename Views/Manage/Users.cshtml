@model List<AppUser>
@{ var me = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<h1 class="pt">Tài khoản &amp; vai trò</h1>
<p class="muted">Admin: toàn quyền • Staff: các chức năng do Admin cấp riêng cho từng tài khoản (bấm “Phân quyền”) • Customer: khách mua hàng</p>

<div class="panel" style="margin:16px 0">
    <h3>Tạo tài khoản Staff</h3>
    <form method="post" action="/Manage/CreateStaff" asp-antiforgery="true" class="fgrid">
        <div><label>Họ tên</label><input name="fullName" required></div>
        <div><label>Email</label><input name="email" type="email" required></div>
        <div><label>Mật khẩu (tối thiểu 6 ký tự)</label><input name="password" type="text" minlength="6" required autocomplete="off"></div>
        <div style="align-self:end"><button class="btn">+ Tạo Staff</button></div>
    </form>
</div>

<div class="scroll"><table>
    <tr><th>Email</th><th>Họ tên</th><th>Vai trò</th><th>Trạng thái</th><th>Chức năng được phép</th><th>Thao tác</th></tr>
    @foreach (var u in Model)
    {
        var self = u.Id.ToString() == me;
        <tr class="@(u.IsLocked ? "row-off" : "")">
            <td>@u.Email</td><td>@u.FullName</td>
            <td>
                <form method="post" action="/Manage/SetRole" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@u.Id">
                    <select name="role" data-autosubmit disabled="@self">
                        @foreach (var r in new[] { "Admin", "Staff", "Customer" }) { <option selected="@(r == u.Role)">@r</option> }
                    </select>
                </form>
            </td>
            <td>@if (u.IsLocked) { <span class="tag tag-bad">Đã khóa</span> } else { <span class="tag tag-ok">Hoạt động</span> }</td>
            <td>
                @if (u.Role == "Admin") { <span class="muted">Toàn quyền</span> }
                else if (u.Role == "Staff")
                {
                    var n = Perm.Effective(u.Role, u.Permissions).Length;
                    <a class="btn btn-s" href="/Manage/Permissions/@u.Id">🔐 Phân quyền</a>
                    <span class="muted">@n/@Perm.Keys.Length quyền@(string.IsNullOrEmpty(u.Permissions) ? " (mặc định)" : "")</span>
                }
                else { <span class="muted">—</span> }
            </td>
            <td>
                @if (!self)
                {
                    <form method="post" action="/Manage/ToggleLock" class="inline" asp-antiforgery="true">
                        <input type="hidden" name="id" value="@u.Id">
                        <button class="btn btn-s @(u.IsLocked ? "" : "btn-d")">@(u.IsLocked ? "Mở khóa" : "Khóa")</button>
                    </form>
                }
                <form method="post" action="/Manage/ResetPassword" class="priceform" style="display:inline-flex" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@u.Id">
                    <input name="password" type="text" placeholder="Mật khẩu mới" minlength="6" required autocomplete="off" style="width:140px">
                    <button class="btn btn-s btn-g">Đặt lại MK</button>
                </form>
            </td>
        </tr>
    }
</table></div>
