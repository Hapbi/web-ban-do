@model Post
<div class="box wide">
    <h2>@(Model.Id == 0 ? "Viết" : "Sửa") bài viết</h2>
    <div asp-validation-summary="All" style="color:var(--red)"></div>
    <form method="post">
        <input type="hidden" asp-for="Id">
        <label>Tiêu đề</label><input asp-for="Title" required>
        <label>Tóm tắt</label><textarea asp-for="Summary" rows="2"></textarea>
        <label>Nội dung (xuống dòng = đoạn mới)</label><textarea asp-for="Content" rows="10"></textarea>
        <label>Link ảnh bìa (http/https)</label><input asp-for="ImageUrl">
        <label style="display:flex;align-items:center;gap:8px;margin-top:12px">
            <input type="checkbox" name="IsPublished" value="true" checked="@Model.IsPublished" style="width:auto;margin:0"> Đăng công khai
            <input type="hidden" name="IsPublished" value="false">
        </label>
        <div style="margin-top:16px"><button class="btn">Lưu</button> <a class="btn btn-g" href="/Manage/Posts">Hủy</a></div>
    </form>
</div>
