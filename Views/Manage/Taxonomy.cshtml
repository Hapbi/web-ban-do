@model List<TaxRow>
@{
    string type = ViewBag.Type;
    var label = type == "brand" ? "thương hiệu" : type == "tag" ? "tag" : "danh mục";
}
<h1 class="pt">Danh mục · Thương hiệu · Tag</h1>
<p>
    <a class="btn btn-s @(type == "category" ? "" : "btn-g")" href="/Manage/Taxonomy?type=category">Danh mục</a>
    <a class="btn btn-s @(type == "brand" ? "" : "btn-g")" href="/Manage/Taxonomy?type=brand">Thương hiệu</a>
    <a class="btn btn-s @(type == "tag" ? "" : "btn-g")" href="/Manage/Taxonomy?type=tag">Tag</a>
</p>
<form method="post" action="/Manage/TaxonomyAdd" asp-antiforgery="true" style="display:flex;gap:10px;max-width:480px;margin:14px 0">
    <input type="hidden" name="type" value="@type">
    <input name="name" placeholder="Tên @label mới" required maxlength="80">
    <button class="btn">+ Thêm</button>
</form>
<div class="scroll"><table>
    <tr><th>Tên @label</th><th>Số sản phẩm</th><th></th></tr>
    @foreach (var r in Model)
    {
        <tr>
            <td>
                <form method="post" action="/Manage/TaxonomyRename" class="priceform" asp-antiforgery="true">
                    <input type="hidden" name="type" value="@type"><input type="hidden" name="id" value="@r.Id">
                    <input name="name" value="@r.Name" required maxlength="80" style="width:240px">
                    <button class="btn btn-s btn-g">Đổi tên</button>
                </form>
            </td>
            <td>@r.Used</td>
            <td>
                <form method="post" action="/Manage/TaxonomyDelete" class="inline" data-confirm="@(type == "tag" ? "Xóa tag này khỏi tất cả sản phẩm?" : "Xóa mục này?")" asp-antiforgery="true">
                    <input type="hidden" name="type" value="@type"><input type="hidden" name="id" value="@r.Id">
                    <button class="btn btn-s btn-d">Xóa</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="3" class="muted">Chưa có @label nào.</td></tr> }
</table></div>
<p class="muted">Đổi tên sẽ cập nhật luôn các sản phẩm đang dùng. Danh mục / thương hiệu đang có sản phẩm thì không xóa được.</p>
