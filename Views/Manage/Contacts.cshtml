@model List<Contact>
@{ string type = ViewBag.Type; string status = ViewBag.Status; }
<h1 class="pt">Liên hệ &amp; phản ánh</h1>
<p class="muted">Có <b>@ViewBag.NewCount</b> mục mới chưa xử lý.</p>
<form method="get" style="display:flex;gap:10px;max-width:420px;margin:10px 0">
    <select name="type" data-autosubmit>
        <option value="">Tất cả loại</option>
        @foreach (var t in ContactSts.Types) { <option selected="@(t == type)">@t</option> }
    </select>
    <select name="status" data-autosubmit>
        <option value="">Tất cả trạng thái</option>
        @foreach (var s in ContactSts.All) { <option selected="@(s == status)">@s</option> }
    </select>
</form>
<div class="scroll"><table>
    <tr><th>Người gửi</th><th>Nội dung</th><th>Xử lý</th></tr>
    @foreach (var c in Model)
    {
        <tr>
            <td>
                <span class="tag @(c.Type == "Phản ánh" ? "tag-warn" : "tag-off")">@c.Type</span><br>
                <b>@c.Name</b><br>@c.Email<br>@c.Phone<br><small>@c.Created.ToString("dd/MM/yyyy HH:mm")</small>
            </td>
            <td style="max-width:420px;white-space:pre-line">@c.Message</td>
            <td>
                <form method="post" action="/Manage/ContactUpdate" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@c.Id">
                    <select name="status">
                        @foreach (var s in ContactSts.All) { <option selected="@(s == c.Status)">@s</option> }
                    </select>
                    <textarea name="note" rows="2" placeholder="Ghi chú xử lý / nội dung đã phản hồi" style="margin-top:6px">@c.StaffNote</textarea>
                    <button class="btn btn-s" style="margin-top:6px">Lưu</button>
                    @if (!string.IsNullOrEmpty(c.HandledBy)) { <small class="muted"> Xử lý bởi @c.HandledBy</small> }
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="3" class="muted">Không có mục nào.</td></tr> }
</table></div>
