@model ShopSetting
<div class="box wide">
    <h2>Cấu hình shop &amp; mã QR thanh toán</h2>
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id">
        <label>Tên shop</label><input asp-for="ShopName">
        <label>Địa chỉ</label><input asp-for="Address">
        <label>Điện thoại</label><input asp-for="Phone">
        <label>Email</label><input asp-for="Email">
        <label>Giờ mở cửa</label><input asp-for="OpenHours">
        <label>Ngân hàng</label><input asp-for="BankName">
        <label>Số tài khoản</label><input asp-for="AccountNo">
        <label>Chủ tài khoản</label><input asp-for="AccountHolder">
        <label>Ảnh mã QR (png/jpg/webp, &lt; 2MB)</label>
        <input type="file" name="qr" accept="image/*" id="qrInput">
        <img id="qrPreview" class="qr" src="@(string.IsNullOrEmpty(Model.QrImage) ? "" : "/uploads/" + Model.QrImage)" style="@(string.IsNullOrEmpty(Model.QrImage) ? "display:none" : "")">
        <button class="btn block" style="margin-top:14px">Lưu</button>
    </form>
</div>
