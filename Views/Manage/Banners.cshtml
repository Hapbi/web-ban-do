@model List<Banner>
<h1 class="pt">Banner trang chủ</h1>
<p class="muted">Banner đang bật sẽ hiện ở đầu trang chủ theo thứ tự. Nếu không có banner nào, trang chủ dùng ảnh nền mặc định.</p>
<div class="panel" style="margin:14px 0">
    <h3>Thêm banner</h3>
    <form method="post" action="/Manage/BannerSave" asp-antiforgery="true" class="fgrid">
        <input type="hidden" name="id" value="0">
        <div><label>Tiêu đề</label><input name="title" maxlength="120"></div>
        <div><label>Link ảnh (http/https)</label><input name="imageUrl" required></div>
        <div><label>Link khi bấm vào (tuỳ chọn)</label><input name="linkUrl" placeholder="/Home/Products"></div>
        <div><label>Thứ tự</label><input name="sortOrder" type="number" value="0"></div>
        <label style="display:flex;align-items:center;gap:8px"><input type="checkbox" name="isActive" value="true" checked style="width:auto;margin:0"> Hiển thị<input type="hidden" name="isActive" value="false"></label>
        <div><button class="btn">+ Thêm</button></div>
    </form>
</div>
<div class="scroll"><table>
    <tr><th>Ảnh</th><th>Thông tin</th><th></th></tr>
    @foreach (var b in Model)
    {
        <tr class="@(b.IsActive ? "" : "row-off")">
            <td style="width:180px"><img src="@b.ImageUrl" alt="" style="width:160px;height:70px;object-fit:cover;border-radius:6px" onerror="this.style.display='none'"></td>
            <td>
                <form method="post" action="/Manage/BannerSave" asp-antiforgery="true" class="fgrid">
                    <input type="hidden" name="id" value="@b.Id">
                    <div><label>Tiêu đề</label><input name="title" value="@b.Title" maxlength="120"></div>
                    <div><label>Link ảnh</label><input name="imageUrl" value="@b.ImageUrl" required></div>
                    <div><label>Link đích</label><input name="linkUrl" value="@b.LinkUrl"></div>
                    <div><label>Thứ tự</label><input name="sortOrder" type="number" value="@b.SortOrder"></div>
                    <label style="display:flex;align-items:center;gap:8px"><input type="checkbox" name="isActive" value="true" checked="@b.IsActive" style="width:auto;margin:0"> Hiển thị<input type="hidden" name="isActive" value="false"></label>
                    <div><button class="btn btn-s">Lưu</button></div>
                </form>
            </td>
            <td>
                <form method="post" action="/Manage/BannerDelete" class="inline" data-confirm="Xóa banner này?" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@b.Id"><button class="btn btn-s btn-d">Xóa</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="3" class="muted">Chưa có banner nào.</td></tr> }
</table></div>
