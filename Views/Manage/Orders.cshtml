@model List<Order>
<h1 class="pt">Quản lý đơn hàng</h1>
<div class="scroll"><table>
    <tr><th>Mã</th><th>Khách</th><th>Giao đến</th><th>Sản phẩm</th><th>Tổng</th><th>Trạng thái</th></tr>
    @foreach (var o in Model)
    {
        <tr>
            <td>#DH@(o.Id)<br><small>@o.Created.ToString("dd/MM HH:mm")</small><br><a class="btn btn-s btn-g" href="/Manage/PrintOrder/@o.Id" target="_blank">In đơn</a></td>
            <td>@o.User?.Email</td>
            <td>@o.Receiver<br>@o.Phone<br>@o.Address</td>
            <td>@string.Join(", ", o.Items.Select(i => i.ProductName + " x" + i.Qty))</td>
            <td>@o.Total.Money()<br><small class="muted">@(o.PaymentMethod == PayM.COD ? "💵 COD - thu khi giao" : "🏦 Chuyển khoản")</small></td>
            <td>
                <form method="post" action="/Manage/SetStatus" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@o.Id">
                    <select name="status" data-autosubmit disabled="@(!User.Can("order.status"))">
                        @foreach (var s in Sts.For(o.PaymentMethod).Union(new[] { o.Status })) { <option selected="@(s == o.Status)">@s</option> }
                    </select>
                </form>
            </td>
        </tr>
    }
</table></div>
