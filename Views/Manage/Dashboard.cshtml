@model DashVm
@{
    ViewData["Title"] = "Dashboard - ";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var roleName = role == "Admin" ? "Quản trị viên" : "Staff";
    var max = Model.Days.Count == 0 ? 0 : Model.Days.Max(d => d.Amount);
    var paidTotal = Model.Total;
    var totalStockItems = Model.InStock + Model.LowStock + Model.OutStock;
}
<section class="admin-dashboard">
    <div class="dash-heading">
        <div>
            <div class="dash-eyebrow"><span class="dash-eyebrow-dot"></span> TRUNG TÂM QUẢN LÝ</div>
            <h1 class="pt">Dashboard</h1>
            <p class="muted">Xin chào <b>@User.Identity.Name</b> · @roleName. Đây là tình hình cửa hàng của bạn.</p>
        </div>
        <div class="dash-heading-actions">
            <span class="dash-date"><span>◷</span> @DateTime.Now.ToString("dd/MM/yyyy")</span>
            @if (User.CanProducts())
            {
                <a class="btn dash-primary-btn" href="/Manage/ProductForm">＋ Thêm sản phẩm</a>
            }
        </div>
    </div>

    @if (User.Can("revenue.view"))
    {
        <div class="dash-section-title">
            <div><span class="dash-section-icon">↗</span><h2>Doanh thu</h2></div>
            <a href="/Manage/Orders">Xem đơn hàng <span>→</span></a>
        </div>

        <div class="dash-stat-grid">
            <article class="dash-stat stat-red">
                <div class="dash-stat-top"><span>Doanh thu hôm nay</span><span class="stat-icon">₫</span></div>
                <strong>@Model.Today.Money()</strong>
                <small><span class="stat-dot"></span> Tổng tiền đơn đã thanh toán hôm nay</small>
                <div class="stat-watermark">₫</div>
            </article>
            <article class="dash-stat stat-violet">
                <div class="dash-stat-top"><span>Doanh thu tháng này</span><span class="stat-icon">▦</span></div>
                <strong>@Model.Month.Money()</strong>
                <small><span class="stat-dot"></span> Từ đầu tháng đến hiện tại</small>
                <div class="stat-watermark">▦</div>
            </article>
            <article class="dash-stat stat-blue">
                <div class="dash-stat-top"><span>Tổng doanh thu</span><span class="stat-icon">↗</span></div>
                <strong>@paidTotal.Money()</strong>
                <small><b>@Model.PaidCount</b> đơn đã thanh toán</small>
                <div class="stat-watermark">↗</div>
            </article>
            <article class="dash-stat stat-amber">
                <div class="dash-stat-top"><span>Chờ xác nhận</span><span class="stat-icon">◷</span></div>
                <strong>@Model.WaitConfirm</strong>
                <small>@Model.WaitConfirmAmount.Money() · @Model.WaitPay đơn chờ thanh toán</small>
                <div class="stat-watermark">◷</div>
            </article>
        </div>

        <div class="dash-analytics-grid">
            <section class="dash-panel revenue-panel">
                <div class="dash-panel-head">
                    <div><h3>Biểu đồ doanh thu</h3><p>Doanh thu 7 ngày gần nhất</p></div>
                    <span class="dash-panel-badge">7 NGÀY</span>
                </div>
                <div class="revenue-chart">
                    <div class="chart-y-labels">
                        <span>@((max).Money())</span>
                        <span>@((max * .66m).Money())</span>
                        <span>@((max * .33m).Money())</span>
                        <span>0đ</span>
                    </div>
                    <div class="chart-plot">
                        <div class="chart-grid-lines"><i></i><i></i><i></i><i></i></div>
                        <div class="chart-columns">
                            @foreach (var d in Model.Days)
                            {
                                var h = max == 0 ? 3 : (int)Math.Round(d.Amount / max * 100);
                                <div class="chart-column" title="@d.Label: @d.Amount.Money()">
                                    <div class="chart-value">@if (d.Amount > 0) { <span>@(d.Amount >= 1000000 ? (d.Amount / 1000000).ToString("0.#") + "tr" : (d.Amount / 1000).ToString("0") + "k")</span> }</div>
                                    <div class="chart-bar-track"><i class="chart-bar-fill" style="height:@(Math.Max(h, 3))%"></i></div>
                                    <span class="chart-day">@d.Label</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="chart-footer"><span><i></i> Doanh thu đã thanh toán</span><b>@Model.Total.Money() tổng cộng</b></div>
            </section>

            <section class="dash-panel best-panel">
                <div class="dash-panel-head">
                    <div><h3>Sản phẩm bán chạy</h3><p>Top sản phẩm theo số lượng bán</p></div>
                    <span class="dash-head-icon">✦</span>
                </div>
                @if (Model.Top.Count == 0)
                {
                    <div class="dash-empty">
                        <span class="empty-illustration">▤</span>
                        <b>Chưa có dữ liệu bán hàng</b>
                        <p>Sản phẩm sẽ xuất hiện tại đây sau khi có đơn đã thanh toán.</p>
                    </div>
                }
                else
                {
                    <div class="best-list">
                        @{ var rank = 0; }
                        @foreach (var t in Model.Top)
                        {
                            rank++;
                            <div class="best-item">
                                <span class="best-rank">@rank.ToString("00")</span>
                                <div class="best-product"><b>@t.Name</b><span>@t.Qty sản phẩm đã bán</span></div>
                                <strong>@t.Amount.Money()</strong>
                            </div>
                        }
                    </div>
                }
                <a class="dash-panel-link" href="/Manage/Orders">Xem chi tiết đơn hàng <span>→</span></a>
            </section>
        </div>
    }

    @if (User.Can("stock.view"))
    {
        <div class="dash-section-title inventory-title">
            <div><span class="dash-section-icon">▦</span><h2>Tổng quan tồn kho</h2></div>
            @if (User.CanProducts()) { <a href="/Manage/Products">Quản lý sản phẩm <span>→</span></a> }
        </div>
        <div class="inventory-summary">
            <a class="inventory-card inv-all" href="/Manage/Dashboard">
                <span class="inventory-icon">▣</span><span class="inventory-label">Tổng sản phẩm hiển thị</span>
                <strong>@totalStockItems</strong><small>Trong danh sách kho</small>
            </a>
            <a class="inventory-card inv-good" href="?f=in">
                <span class="inventory-icon">✓</span><span class="inventory-label">Còn hàng</span>
                <strong>@Model.InStock</strong><small>Tồn kho trên 5 sản phẩm</small>
            </a>
            <a class="inventory-card inv-low" href="?f=low">
                <span class="inventory-icon">!</span><span class="inventory-label">Sắp hết hàng</span>
                <strong>@Model.LowStock</strong><small>Tồn kho từ 1 đến 5</small>
            </a>
            <a class="inventory-card inv-out" href="?f=out">
                <span class="inventory-icon">×</span><span class="inventory-label">Hết hàng</span>
                <strong>@Model.OutStock</strong><small>Cần nhập thêm hàng</small>
            </a>
            @if (User.CanProducts())
            {
                <div class="inventory-card inv-hidden">
                    <span class="inventory-icon">◌</span><span class="inventory-label">Sản phẩm đang ẩn</span>
                    <strong>@Model.HiddenCount</strong><small>Không hiển thị tại cửa hàng</small>
                </div>
            }
        </div>

        <section class="dash-panel stock-panel">
            <div class="dash-panel-head stock-head">
                <div><h3>Chi tiết tồn kho</h3><p>Theo dõi tình trạng hàng hóa trong cửa hàng</p></div>
                <div class="stock-filters">
                    <a class="@(string.IsNullOrEmpty(Model.Filter) ? "selected" : "")" href="/Manage/Dashboard">Tất cả</a>
                    <a class="@(Model.Filter == "in" ? "selected" : "")" href="?f=in">Còn hàng</a>
                    <a class="@(Model.Filter == "low" ? "selected" : "")" href="?f=low">Sắp hết</a>
                    <a class="@(Model.Filter == "out" ? "selected" : "")" href="?f=out">Hết hàng</a>
                </div>
            </div>
            <div class="scroll dash-table-wrap">
                <table class="dash-table">
                    <thead><tr><th>SẢN PHẨM</th><th>DANH MỤC</th><th>TỒN KHO</th><th>TÌNH TRẠNG</th><th>THAO TÁC</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr class="@(p.IsHidden ? "row-off" : "")">
                            <td><div class="stock-product"><span class="stock-product-icon">▣</span><div><b>@p.Name</b>@if (p.IsHidden) { <small>Đang ẩn tại cửa hàng</small> }</div></div></td>
                            <td><span class="category-chip">@p.Category</span></td>
                            <td><strong class="stock-number">@p.Stock</strong><span class="stock-unit"> sản phẩm</span></td>
                            <td>
                                @if (p.Stock <= 0) { <span class="tag tag-bad"><i></i> Hết hàng</span> }
                                else if (p.Stock <= 5) { <span class="tag tag-warn"><i></i> Sắp hết</span> }
                                else { <span class="tag tag-ok"><i></i> Còn hàng</span> }
                            </td>
                            <td>
                                @if (User.CanProducts()) { <a class="table-action" href="/Manage/ProductForm/@p.Id">Chi tiết <span>↗</span></a> }
                                else { <span class="muted">—</span> }
                            </td>
                        </tr>
                    }
                    @if (Model.Products.Count == 0)
                    {
                        <tr><td colspan="5"><div class="table-empty">Không có sản phẩm phù hợp với bộ lọc.</div></td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="stock-table-footer"><span>Hiển thị <b>@Model.Products.Count</b> sản phẩm</span><span>Dữ liệu cập nhật theo kho hiện tại</span></div>
        </section>
    }
</section>
