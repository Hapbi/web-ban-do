@model List<Post>
<h1 class="pt">Quản lý bài viết</h1>
<a class="btn" href="/Manage/PostForm">+ Viết bài mới</a>
<div class="scroll"><table>
    <tr><th>ID</th><th>Tiêu đề</th><th>Tác giả</th><th>Ngày</th><th>Trạng thái</th><th></th></tr>
    @foreach (var p in Model)
    {
        <tr class="@(p.IsPublished ? "" : "row-off")">
            <td>@p.Id</td><td>@p.Title</td><td>@p.Author</td><td>@p.Created.ToString("dd/MM/yyyy")</td>
            <td>@if (p.IsPublished) { <span class="tag tag-ok">Đã đăng</span> } else { <span class="tag tag-off">Bản nháp / ẩn</span> }</td>
            <td>
                <a class="btn btn-s" href="/Manage/PostForm/@p.Id">Sửa</a>
                <form method="post" action="/Manage/TogglePost" class="inline" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@p.Id"><button class="btn btn-s btn-g">@(p.IsPublished ? "Ẩn" : "Đăng")</button>
                </form>
                <form method="post" action="/Manage/DeletePost" class="inline" data-confirm="Xóa bài viết này?" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@p.Id"><button class="btn btn-s btn-d">Xóa</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="muted">Chưa có bài viết nào.</td></tr> }
</table></div>
