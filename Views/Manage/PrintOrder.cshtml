@model Order
@{ Layout = null; var shop = (ShopSetting)ViewBag.Shop; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Đơn hàng #DH@(Model.Id)</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 720px; margin: 24px auto; color: #222; font-size: 14px; }
        h1 { margin: 0 0 4px; } table { width: 100%; border-collapse: collapse; margin: 14px 0; }
        th, td { border: 1px solid #999; padding: 6px 8px; text-align: left; } .r { text-align: right; }
        .noprint button { padding: 8px 16px; margin-bottom: 14px; }
        @@media print { .noprint { display: none; } }
    </style>
</head>
<body>
    <div class="noprint"><button onclick="window.print()">🖨 In đơn</button></div>
    <h1>@shop.ShopName</h1>
    <div>@shop.Address · @shop.Phone</div>
    <h2>ĐƠN HÀNG #DH@(Model.Id)</h2>
    <div>Ngày đặt: @Model.Created.ToString("dd/MM/yyyy HH:mm") · Trạng thái: @Model.Status</div>
    <div>Thanh toán: <b>@(PayM.Label(Model.PaymentMethod) + (Model.PaymentMethod == PayM.COD ? " — thu " + Model.Total.Money() + " khi giao hàng" : ""))</b></div>
    <p><b>Người nhận:</b> @Model.Receiver · @Model.Phone<br><b>Địa chỉ:</b> @Model.Address</p>
    <table>
        <tr><th>Sản phẩm</th><th class="r">Đơn giá</th><th class="r">SL</th><th class="r">Thành tiền</th></tr>
        @foreach (var i in Model.Items)
        {
            <tr><td>@i.ProductName</td><td class="r">@i.Price.Money()</td><td class="r">@i.Qty</td><td class="r">@((i.Price * i.Qty).Money())</td></tr>
        }
        <tr><td colspan="3" class="r"><b>Tổng cộng</b></td><td class="r"><b>@Model.Total.Money()</b></td></tr>
    </table>
    <script>window.onload = () => window.print();</script>
</body>
</html>
