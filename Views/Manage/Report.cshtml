@{
    ViewData["Title"] = "Báo cáo vận hành - ";
    var byStatus = (Dictionary<string, int>)ViewBag.ByStatus;
    var needConfirm = (List<Order>)ViewBag.NeedConfirm;
    var outStock = (List<Product>)ViewBag.OutOfStock;
    var lowStock = (List<Product>)ViewBag.LowStock;
}
<h1 class="pt">Báo cáo vận hành</h1>
<p class="muted">Ngày @(((DateTime)ViewBag.Today).ToString("dd/MM/yyyy")) · những việc cần xử lý trong ngày <button type="button" class="btn btn-s btn-g" onclick="window.print()">🖨 In báo cáo</button></p>

<div class="kpis">
    <div class="kpi"><span>Đơn mới hôm nay</span><b>@ViewBag.OrdersToday</b></div>
    <div class="kpi warn"><span>Chờ xác nhận tiền</span><b>@byStatus["Chờ xác nhận"]</b><small>Cần Staff kiểm tra</small></div>
    <div class="kpi"><span>Đang giao</span><b>@ViewBag.Shipping</b></div>
    <div class="kpi bad"><span>Chờ thanh toán &gt; 24h</span><b>@ViewBag.OldPending</b><small>Cân nhắc hủy để hoàn kho</small></div>
</div>
<div class="kpis">
    <div class="kpi warn"><span>Liên hệ mới</span><b>@ViewBag.NewContacts</b></div>
    <div class="kpi bad"><span>Phản ánh mới</span><b>@ViewBag.NewFeedback</b></div>
    <div class="kpi"><span>Đang xử lý</span><b>@ViewBag.Processing</b></div>
    <div class="kpi"><span>Bài viết nháp</span><b>@ViewBag.DraftPosts</b></div>
</div>

<div class="dash2">
    <div class="panel">
        <h3>Đơn cần xác nhận tiền (cũ nhất trước)</h3>
        @if (needConfirm.Count == 0) { <p class="muted">Không có đơn nào đang chờ.</p> }
        else
        {
            <table class="kv">
                @foreach (var o in needConfirm)
                {
                    <tr><td>#DH@(o.Id)</td><td>@o.Receiver</td><td>@o.Total.Money()</td><td><small>@o.Created.ToString("dd/MM HH:mm")</small></td></tr>
                }
            </table>
        }
        <p><a class="btn btn-s" href="/Manage/Orders">Mở quản lý đơn hàng</a></p>
    </div>
    <div class="panel">
        <h3>Đơn theo trạng thái</h3>
        <table class="kv">
            @foreach (var kv in byStatus) { <tr><td>@kv.Key</td><td><b>@kv.Value</b></td></tr> }
        </table>
    </div>
</div>

<div class="dash2" style="margin-top:16px">
    <div class="panel">
        <h3>Hết hàng (@outStock.Count)</h3>
        @if (outStock.Count == 0) { <p class="muted">Không có.</p> }
        else { <p>@string.Join(", ", outStock.Select(p => p.Name))</p> }
    </div>
    <div class="panel">
        <h3>Sắp hết (≤ 5) (@lowStock.Count)</h3>
        @if (lowStock.Count == 0) { <p class="muted">Không có.</p> }
        else { <table class="kv">@foreach (var p in lowStock) { <tr><td>@p.Name</td><td>còn <b>@p.Stock</b></td></tr> }</table> }
    </div>
</div>
