@model Order
@{ var cod = Model.PaymentMethod == PayM.COD; }
<div class="center">
    <div class="ok">✓</div>
    <h1 class="big">@(cod ? "Đặt hàng thành công!" : "Đã ghi nhận thanh toán!")</h1>
    <p class="muted">@(cod ? "Shop sẽ liên hệ xác nhận và giao hàng. Bạn thanh toán tiền mặt khi nhận hàng." : "Shop sẽ xác nhận đơn hàng của bạn sau khi nhận được tiền.")</p>
    <div class="box wide">
        <table class="kv" style="border:0">
            <tr><td>Mã đơn hàng</td><td><b>#DH@(Model.Id)</b></td></tr>
            <tr><td>Phương thức</td><td>@PayM.Label(Model.PaymentMethod)</td></tr>
            <tr><td>@(cod ? "Số tiền thanh toán khi nhận" : "Tổng thanh toán")</td><td><b style="color:var(--red)">@Model.Total.Money()</b></td></tr>
            <tr><td>Trạng thái</td><td>@Model.Status</td></tr>
        </table>
    </div>
    <a class="btn" href="/Order/Detail/@Model.Id">Xem hóa đơn</a> <a class="btn-o" href="/Order/My">Đơn hàng của tôi</a>
    <p style="margin-top:18px"><a href="/" class="muted">Hoặc tiếp tục mua sắm</a></p>
</div>
