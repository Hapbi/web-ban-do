@model List<CartLine>
@{
    var u = (AppUser)ViewBag.User;
    var total = Model.Sum(l => l.P.Price * l.Qty);
}
<h1 class="pt">Thanh toán</h1>
<p class="muted">Hoàn tất thông tin để đặt hàng</p>
<form class="two" method="post">
    <div>
        <div class="panel">
            <h3>Thông tin nhận hàng</h3>
            <div class="fgrid">
                <div><label>Họ và tên</label><input name="receiver" value="@u.FullName" required></div>
                <div><label>Số điện thoại</label><input name="phone" value="@u.Phone" required></div>
            </div>
            <label>Địa chỉ chi tiết</label><input name="address" required>
        </div>
        <div class="panel" style="margin-top:20px">
            <h3>Phương thức thanh toán</h3>
            <div class="pay-opts">
                <label class="pay-opt"><input type="radio" name="method" value="QR" checked> 🏦 Chuyển khoản QR ngân hàng</label>
                <label class="pay-opt"><input type="radio" name="method" value="COD"> 💵 Thanh toán khi nhận hàng (COD)</label>
            </div>
            <p class="note" data-note="QR">Sau khi đặt hàng, bạn sẽ nhận mã QR để chuyển khoản.</p>
            <p class="note" data-note="COD" hidden>Bạn trả tiền mặt cho nhân viên giao hàng khi nhận hàng. Shop sẽ liên hệ xác nhận đơn trước khi giao.</p>
        </div>
    </div>
    <div class="panel">
        <h3>Đơn hàng</h3>
        <p class="muted">@Model.Count sản phẩm</p>
        <div class="sl"><span>Tạm tính</span><b>@total.Money()</b></div>
        <div class="sl"><span>Phí giao hàng</span><b>Miễn phí</b></div>
        <div class="sl total"><span>Thanh toán</span><b>@total.Money()</b></div>
        <button class="btn block" style="margin-top:20px">Đặt hàng</button>
        <p class="note">Bằng việc đặt hàng, bạn đồng ý với điều khoản mua hàng.</p>
    </div>
</form>
