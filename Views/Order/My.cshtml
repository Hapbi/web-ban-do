@model List<Order>
@{
    string tab = ViewBag.Tab;
    var tabs = new[] { "Tất cả" }.Concat(Sts.All).ToList();
    var list = Model.Where(o => tab == "Tất cả" || o.Status == tab).ToList();
}
<h1 class="pt">Đơn hàng của tôi</h1>
<div class="tabs">
    @foreach (var t in tabs) { <a class="@(t == tab ? "on" : "")" href="/Order/My?tab=@Uri.EscapeDataString(t)">@t</a> }
</div>
@foreach (var o in list)
{
    <div class="order">
        <div class="oh">
            <span>#DH@(o.Id)</span>
            <span class="st @(o.Status == "Hoàn thành" ? "done" : o.Status == "Đã hủy" ? "cancel" : "")">@o.Status</span>
        </div>
        @foreach (var i in o.Items)
        {
            <div class="oi">
                <div class="th"></div>
                <div class="grow"><b>@i.ProductName</b><span>Số lượng: @i.Qty • @(o.PaymentMethod == PayM.COD ? "Thanh toán khi nhận hàng" : "Chuyển khoản QR")</span></div>
                <b>@((i.Price * i.Qty).Money())</b>
            </div>
        }
        <div class="ofoot">
            <span class="muted">@o.Created.ToString("dd/MM/yyyy HH:mm") • Tổng: <b style="color:var(--text)">@o.Total.Money()</b></span>
            <span style="display:flex;gap:10px">
                @if (o.Status == Sts.All[0]) { <a class="btn btn-s" href="/Order/Pay/@o.Id">Thanh toán</a> }
                <a class="btn-o btn-s" href="/Order/Detail/@o.Id">Xem chi tiết</a>
            </span>
        </div>
    </div>
}
@if (list.Count == 0) { <p class="muted">Chưa có đơn hàng.</p> }
