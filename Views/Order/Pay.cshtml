@model Order
@{ var s = (ShopSetting)ViewBag.Shop; }
<div class="box wide center">
    <h2>Thanh toán chuyển khoản - Đơn #DH@(Model.Id)</h2>
    @if (!string.IsNullOrEmpty(s.QrImage)) { <img class="qr" src="/uploads/@s.QrImage" alt="QR"> }
    else { <p style="color:var(--red)">Shop chưa cập nhật mã QR, vui lòng liên hệ @s.Phone</p> }
    <table class="kv">
        <tr><td>Ngân hàng</td><td>@s.BankName</td></tr>
        <tr><td>Số tài khoản</td><td>@s.AccountNo</td></tr>
        <tr><td>Chủ tài khoản</td><td>@s.AccountHolder</td></tr>
        <tr><td>Số tiền</td><td><b style="color:var(--red)">@Model.Total.Money()</b></td></tr>
        <tr><td>Nội dung CK</td><td><b id="memo">DH@(Model.Id)</b> <button type="button" class="btn-o btn-s" data-copy="#memo">Sao chép</button></td></tr>
    </table>
    <div style="margin-top:18px">
        @if (Model.Status == Sts.All[0] && Model.UserId == int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value))
        {
            <form method="post" action="/Order/Paid" asp-antiforgery="true"><input type="hidden" name="id" value="@Model.Id"><button class="btn block">✅ Tôi đã chuyển khoản</button></form>
        }
        else
        {
            <p><b>Trạng thái: @Model.Status</b></p>
            <a class="btn" href="/Order/My">Xem đơn hàng</a>
        }
    </div>
    <p class="note">Shop sẽ xác nhận đơn sau khi nhận được tiền.</p>
</div>
