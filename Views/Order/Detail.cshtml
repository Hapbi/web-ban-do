@model Order
@{
    var s = (ShopSetting)ViewBag.Shop;
    var cod = Model.PaymentMethod == PayM.COD;
    var meId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value);
    string payState = Model.Status == "Đã hủy" ? "Đã hủy"
        : Sts.Counts(Model) ? "Đã thanh toán"
        : cod ? "Thanh toán tiền mặt khi nhận hàng"
        : Model.Status == Sts.All[0] ? "Chưa thanh toán" : "Chờ shop xác nhận tiền";
    var stt = 0;
    var sub = Model.Items.Sum(i => i.Price * i.Qty);
}
<div class="noprint crumb"><a href="/Order/My">← Đơn hàng của tôi</a></div>
<div class="invoice">
    <div class="inv-head">
        <div>
            <h2>@s.ShopName</h2>
            <div class="muted">@s.Address</div>
            <div class="muted">@s.Phone · @s.Email</div>
        </div>
        <div class="inv-title">
            <h1>HÓA ĐƠN</h1>
            <div>Mã đơn: <b>#DH@(Model.Id)</b></div>
            <div>Ngày đặt: @Model.Created.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>
    <div class="inv-info">
        <div>
            <h4>Người nhận</h4>
            <div><b>@Model.Receiver</b></div>
            <div>@Model.Phone</div>
            <div>@Model.Address</div>
        </div>
        <div>
            <h4>Thanh toán</h4>
            <div>@PayM.Label(Model.PaymentMethod)</div>
            <div>Tình trạng: <b>@payState</b></div>
            <div>Trạng thái đơn: <b>@Model.Status</b></div>
        </div>
    </div>
    <div class="scroll">
        <table class="inv-table">
            <tr><th>#</th><th>Sản phẩm</th><th class="r">Đơn giá</th><th class="r">SL</th><th class="r">Thành tiền</th></tr>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@(++stt)</td>
                    <td>@i.ProductName</td>
                    <td class="r">@i.Price.Money()</td>
                    <td class="r">@i.Qty</td>
                    <td class="r">@((i.Price * i.Qty).Money())</td>
                </tr>
            }
        </table>
    </div>
    <div class="inv-total">
        <div class="sl"><span>Tạm tính</span><b>@sub.Money()</b></div>
        <div class="sl"><span>Phí giao hàng</span><b>Miễn phí</b></div>
        <div class="sl total"><span>@(cod && Model.Status != "Hoàn thành" && Model.Status != "Đã hủy" ? "Tổng thu khi nhận hàng" : "Tổng cộng")</span><b>@Model.Total.Money()</b></div>
    </div>
    <p class="note">Cảm ơn quý khách đã mua hàng tại @s.ShopName. Mọi thắc mắc xin liên hệ @s.Phone.</p>
</div>
<div class="noprint inv-actions">
    <button class="btn" onclick="window.print()">🖨 In hóa đơn</button>
    @if (!cod && Model.Status == Sts.All[0] && Model.UserId == meId)
    {
        <a class="btn-o" href="/Order/Pay/@Model.Id">Thanh toán QR</a>
    }
    <a class="btn-o" href="/Order/My">Quay lại đơn hàng</a>
</div>
