@model ProductDetailVM
@{ ViewData["Title"] = Model.Product.Name; var p = Model.Product; var galleryImages = p.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.SortOrder).ToList(); }

<div class="container product-detail-page">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <a href="/san-pham?cat=@p.Category?.Slug">@p.Category?.Name</a>
        <span>/</span>
        <span>@p.Name</span>
    </nav>

    <div class="detail-grid">
        <div class="detail-gallery reveal">
            <div class="gallery-main">
                <img id="gallery-main-img" src="@(galleryImages.FirstOrDefault()?.Url ?? "/images/products/fallback.svg")" alt="@p.Name" onerror="this.onerror=null;this.src='/images/products/fallback.svg'" />
                @if (p.DiscountPercent > 0) { <span class="badge-discount large">-@p.DiscountPercent%</span> }
            </div>
            @if (galleryImages.Count > 1)
            {
                <div class="gallery-thumbs">
                    @for (int i = 0; i < galleryImages.Count; i++)
                    {
                        <button type="button" class="thumb @(i == 0 ? "active" : "")"
                                onclick="switchImage(this, '@galleryImages[i].Url')"
                                aria-label="Ảnh @(i+1)">
                            <img src="@galleryImages[i].Url" alt="" onerror="this.onerror=null;this.src='/images/products/fallback.svg'" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="detail-info reveal">
            <div class="detail-brand">@p.Brand?.Name · @p.Category?.Name</div>
            <h1 class="detail-title">@p.Name</h1>

            <div class="detail-rating">
                <span class="stars">
                    @{
                        var avg = Math.Round(Model.AverageRating);
                    }
                    @for (int i = 1; i <= 5; i++) { <span class="@(i <= avg ? "star-filled" : "star-empty")">★</span> }
                </span>
                <span>@Model.AverageRating.ToString("0.0")/5</span>
                <span>· @Model.ReviewCount đánh giá</span>
                <span>· Đã bán @p.SoldCount</span>
            </div>

            <div class="detail-price-box">
                <span class="price-current large @(p.HasDiscount ? "price-sale" : "")">@p.CurrentPrice.ToString("N0")đ</span>
                @if (p.HasDiscount)
                {
                    <span class="price-original large">@p.OriginalPrice.ToString("N0")đ</span>
                    <span class="price-save">Tiết kiệm @((p.OriginalPrice - p.CurrentPrice).ToString("N0"))đ</span>
                }
            </div>

            <p class="detail-short-desc">@p.ShortDescription</p>

            <div class="detail-stock">
                @if (p.Stock > 5) { <span class="stock-badge stock-ok">✓ Còn hàng (@p.Stock sản phẩm)</span> }
                else if (p.Stock > 0) { <span class="stock-badge stock-low">⚠ Chỉ còn @p.Stock sản phẩm</span> }
                else { <span class="stock-badge stock-out">✗ Hết hàng</span> }
            </div>

            @if (p.Stock > 0)
            {
                <form method="post" action="/gio-hang/them" class="detail-actions">
                    <input type="hidden" name="productId" value="@p.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <div class="qty-stepper">
                        <button type="button" onclick="this.parentElement.querySelector('input').stepDown()">−</button>
                        <input type="number" name="quantity" value="1" min="1" max="@Math.Min(p.Stock, 20)" />
                        <button type="button" onclick="this.parentElement.querySelector('input').stepUp()">+</button>
                    </div>
                    <button type="submit" class="btn-primary btn-lg">🛒 Thêm vào giỏ</button>
                </form>
            }

            <div class="detail-badges">
                <div class="badge-item">🛡️ Bảo hành chính hãng</div>
                <div class="badge-item">↩️ Đổi trả 7 ngày</div>
                <div class="badge-item">🚚 Free ship từ 5 triệu</div>
            </div>

            <div class="detail-wishlist">
                <form method="post" action="/yeu-thich/toggle">
                    <input type="hidden" name="productId" value="@p.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn-wishlist @(Model.IsWishlisted ? "active" : "")">
                        @(Model.IsWishlisted ? "❤️ Đã yêu thích" : "🤍 Yêu thích")
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="detail-tabs">
        <div class="tab-nav">
            <button class="tab-btn active" onclick="showTab(this, 'tab-desc')">Mô tả</button>
            <button class="tab-btn" onclick="showTab(this, 'tab-specs')">Thông số</button>
            <button class="tab-btn" onclick="showTab(this, 'tab-reviews')">Đánh giá (@Model.ReviewCount)</button>
        </div>

        <div class="tab-content active" id="tab-desc">
            <p>@p.Description</p>
        </div>

        <div class="tab-content" id="tab-specs">
            @if (p.Specs.Any())
            {
                <table class="specs-table">
                    @foreach (var s in p.Specs.OrderBy(x => x.SortOrder))
                    {
                        <tr><th>@s.Name</th><td>@s.Value</td></tr>
                    }
                </table>
            }
            else
            {
                <p class="muted">Chưa có thông số kỹ thuật.</p>
            }
        </div>

        <div class="tab-content" id="tab-reviews">
            <div class="reviews-summary">
                <div class="reviews-big">
                    <div class="reviews-number">@Model.AverageRating.ToString("0.0")</div>
                    <div class="stars">
                        @for (int i = 1; i <= 5; i++) { <span class="@(i <= Math.Round(Model.AverageRating) ? "star-filled" : "star-empty")">★</span> }
                    </div>
                    <div>@Model.ReviewCount đánh giá</div>
                </div>
                <div class="reviews-breakdown">
                    @for (int i = 5; i >= 1; i--)
                    {
                        var count = Model.RatingDistribution[i - 1];
                        var pct = Model.ReviewCount > 0 ? (count * 100 / Model.ReviewCount) : 0;
                        <div class="rating-row">
                            <span>@i ★</span>
                            <div class="rating-bar"><div style="width:@pct%"></div></div>
                            <span>@count</span>
                        </div>
                    }
                </div>
            </div>

            @if (Model.CanReview)
            {
                <div class="review-form-wrapper">
                    <h3>Viết đánh giá</h3>
                    <form method="post" action="/danh-gia">
                        <input type="hidden" name="ProductId" value="@p.Id" />
                        <div class="form-group">
                            <label>Đánh giá của bạn</label>
                            <div class="star-input">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" id="rate@(i)" name="Rating" value="@i" checked="@(i == 5)" />
                                    <label for="rate@(i)">★</label>
                                }
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Tiêu đề</label>
                            <input type="text" name="Title" required placeholder="Ví dụ: Sản phẩm tuyệt vời" />
                        </div>
                        <div class="form-group">
                            <label>Nội dung</label>
                            <textarea name="Content" rows="4" required placeholder="Chia sẻ cảm nhận của bạn..."></textarea>
                        </div>
                        <button type="submit" class="btn-primary">Gửi đánh giá</button>
                    </form>
                </div>
            }
            else if (Model.HasReviewed)
            {
                <div class="alert alert-info">Bạn đã đánh giá sản phẩm này.</div>
            }
            else
            {
                <div class="alert alert-warning">Bạn cần mua và nhận sản phẩm để đánh giá.</div>
            }

            <div class="reviews-list">
                @foreach (var r in p.Reviews.Where(x => x.Status == ReviewStatus.Approved).OrderByDescending(x => x.CreatedAt))
                {
                    <div class="review-item">
                        <div class="review-header">
                            <span class="review-avatar">@(r.User?.Avatar ?? "U")</span>
                            <div>
                                <div class="review-name">@(r.User?.FullName ?? "Ẩn danh")</div>
                                <div class="stars">
                                    @for (int i = 1; i <= 5; i++) { <span class="@(i <= r.Rating ? "star-filled" : "star-empty")">★</span> }
                                </div>
                            </div>
                            @if (r.IsVerifiedPurchase) { <span class="verified-badge">✓ Đã mua</span> }
                            <span class="review-date">@r.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                        <h4>@r.Title</h4>
                        <p>@r.Content</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.Related.Any())
    {
        <section class="section">
            <div class="section-head"><h2>Sản phẩm liên quan</h2></div>
            <div class="product-grid">
                @foreach (var rel in Model.Related) { <partial name="_ProductCard" model="rel" /> }
            </div>
        </section>
    }
</div>

<script>
function switchImage(btn, url) {
    document.getElementById('gallery-main-img').src = url;
    document.querySelectorAll('.gallery-thumbs .thumb').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
}
function showTab(btn, id) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(id).classList.add('active');
}
</script>


