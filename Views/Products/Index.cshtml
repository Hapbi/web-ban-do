@model ProductListVM
@{ ViewData["Title"] = Model.Heading; }

<div class="container product-list-page">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <a href="/san-pham">Sản phẩm</a>
        @if (!string.IsNullOrEmpty(Model.CategorySlug)) { <span>/</span> <span>@Model.Heading</span> }
    </nav>

    <div class="page-header">
        <div>
            <h1>@Model.Heading</h1>
            <p class="page-subtitle">@Model.Total sản phẩm</p>
        </div>
        <div class="sort-box">
            <label for="sort">Sắp xếp:</label>
            <select id="sort" onchange="location.search = updateQuery('sort', this.value)">
                <option value="newest" selected="@(Model.Sort == "newest")">Mới nhất</option>
                <option value="popular" selected="@(Model.Sort == "popular")">Bán chạy</option>
                <option value="rating" selected="@(Model.Sort == "rating")">Đánh giá cao</option>
                <option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá tăng dần</option>
                <option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá giảm dần</option>
            </select>
        </div>
    </div>

    <div class="listing-layout">
        <aside class="filters">
            <form method="get" action="/san-pham" id="filter-form">
                <input type="hidden" name="sort" value="@Model.Sort" />
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <input type="hidden" name="q" value="@Model.Search" />
                }

                <div class="filter-group">
                    <h3>Danh mục</h3>
                    <div class="filter-list">
                        <a href="/san-pham?sort=@Model.Sort" class="@(string.IsNullOrEmpty(Model.CategorySlug) ? "active" : "")">Tất cả</a>
                        @foreach (var c in Model.Categories)
                        {
                            <a href="/san-pham?cat=@c.Slug&sort=@Model.Sort" class="@(Model.CategorySlug == c.Slug ? "active" : "")">@c.Icon @c.Name</a>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <h3>Thương hiệu</h3>
                    <div class="filter-list">
                        <a href="/san-pham?@(string.IsNullOrEmpty(Model.CategorySlug) ? "" : $"cat={Model.CategorySlug}&")sort=@Model.Sort" class="@(string.IsNullOrEmpty(Model.BrandSlug) ? "active" : "")">Tất cả</a>
                        @foreach (var b in Model.Brands)
                        {
                            var link = $"/san-pham?brand={b.Slug}";
                            if (!string.IsNullOrEmpty(Model.CategorySlug)) link += $"&cat={Model.CategorySlug}";
                            link += $"&sort={Model.Sort}";
                            <a href="@link" class="@(Model.BrandSlug == b.Slug ? "active" : "")">@b.Name</a>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <h3>Khoảng giá</h3>
                    <div class="price-range">
                        <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="Từ" />
                        <span>-</span>
                        <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Đến" />
                    </div>
                </div>

                <div class="filter-group">
                    <h3>Đánh giá</h3>
                    <div class="filter-list">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <label class="filter-radio">
                                <input type="radio" name="minRating" value="@i" checked="@(Model.MinRating == i)" />
                                <span class="stars">
                                    @for (int j = 1; j <= 5; j++) { <span class="@(j <= i ? "star-filled" : "star-empty")">★</span> }
                                </span>
                                <span>từ @i sao</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <label class="filter-checkbox">
                        <input type="checkbox" name="inStockOnly" value="true" checked="@Model.InStockOnly" />
                        <span>Chỉ hiện còn hàng</span>
                    </label>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-primary">Áp dụng</button>
                    <a href="/san-pham" class="btn-ghost">Xóa bộ lọc</a>
                </div>
            </form>
        </aside>

        <section class="products-section">
            @if (!Model.Products.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">🔍</div>
                    <h3>Không tìm thấy sản phẩm</h3>
                    <p>Thử bỏ bộ lọc hoặc tìm từ khóa khác.</p>
                    <a href="/san-pham" class="btn-primary">Xóa bộ lọc</a>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var p in Model.Products) { <partial name="_ProductCard" model="p" /> }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination">
                        @{
                            var qs = Context.Request.Query;
                            string Pag(int n)
                            {
                                var baseUrl = "/san-pham?" + string.Join("&", qs.Where(k => k.Key != "page").SelectMany(k => k.Value.Select(v => $"{k.Key}={Uri.EscapeDataString(v ?? "")}")));
                                return baseUrl + "&page=" + n;
                            }
                        }
                        @if (Model.Page > 1)
                        {
                            <a href="@Pag(Model.Page - 1)" class="page-link">‹</a>
                        }
                        @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                        {
                            <a href="@Pag(i)" class="page-link @(i == Model.Page ? "active" : "")">@i</a>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a href="@Pag(Model.Page + 1)" class="page-link">›</a>
                        }
                    </nav>
                }
            }
        </section>
    </div>
</div>

<script>
function updateQuery(key, value) {
    const url = new URL(location.href);
    url.searchParams.set(key, value);
    url.searchParams.delete('page');
    return url.search;
}
</script>


