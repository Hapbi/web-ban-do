@model RegisterVM
@{ ViewData["Title"] = "Đăng ký"; }

<div class="auth-page">
    <div class="auth-card">
        <h1>Đăng ký</h1>
        <p class="auth-sub">Tạo tài khoản mới để mua sắm</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">@Html.ValidationSummary(true)</div>
        }

        <form method="post">
            <div class="form-group"><label asp-for="FullName">Họ tên</label><input asp-for="FullName" required /></div>
            <div class="form-group"><label asp-for="Email">Email</label><input asp-for="Email" type="email" required /></div>
            <div class="form-group"><label asp-for="Phone">Số điện thoại</label><input asp-for="Phone" type="tel" required /></div>
            <div class="form-group"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" required /></div>
            <div class="form-group"><label asp-for="ConfirmPassword">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" type="password" required /></div>
            <button type="submit" class="btn-primary btn-lg btn-block">Đăng ký</button>
        </form>

        <p class="auth-footer">Đã có tài khoản? <a href="/dang-nhap">Đăng nhập</a></p>
    </div>
</div>


