<div class="box">
    <h2>Đăng ký khách hàng</h2>
    @if (ViewBag.Err != null) { <p style="color:var(--red)">@ViewBag.Err</p> }
    <form method="post">
        <label>Họ tên</label><input name="fullName" required>
        <label>Email</label><input name="email" type="email" required>
        <label>Số điện thoại</label><input name="phone">
        <label>Mật khẩu (≥ 6 ký tự)</label><input name="password" type="password" minlength="6" required>
        <button class="btn block" style="margin-top:18px">Đăng ký</button>
    </form>
</div>
