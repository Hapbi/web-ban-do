<div class="box">
    <h2>Đăng nhập</h2>
    @if (ViewBag.Err != null) { <p style="color:var(--red)">@ViewBag.Err</p> }
    <form method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.Return">
        <label>Email</label><input name="email" type="email" required>
        <label>Mật khẩu</label><input name="password" type="password" required>
        <label style="display:flex;align-items:center;gap:8px"><input type="checkbox" style="width:auto;margin:0" onchange="document.querySelector('[name=password]').type=this.checked?'text':'password'"> Hiện mật khẩu</label>
        <button class="btn block" style="margin-top:18px">Đăng nhập</button>
    </form>
    <p><a href="/Account/Register" style="color:var(--red)">Chưa có tài khoản? Đăng ký</a></p>
</div>
