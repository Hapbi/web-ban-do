@model ForgotPasswordVM
@{
    ViewData["Title"] = "Khôi phục mật khẩu";
}
<section class="auth-section">
    <div class="auth-card">
        <div class="auth-icon">🔐</div>
        <h1>Khôi phục mật khẩu</h1>
        <p class="auth-sub">Nhập email đã đăng ký để bắt đầu khôi phục tài khoản.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" placeholder="email@example.com" required />
            <span asp-validation-for="Email" class="field-error"></span>
            <button class="btn btn-primary btn-block" type="submit">Tiếp tục</button>
        </form>
        <a asp-action="Login" class="auth-link">Quay lại đăng nhập</a>
        <p class="form-note">Bản demo chưa gửi email đặt lại mật khẩu thật.</p>
    </div>
</section>
