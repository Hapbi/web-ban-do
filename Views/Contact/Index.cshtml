@model ContactMessage
@{ ViewData["Title"] = "Liên hệ"; }

<div class="container contact-page">
    <h1>Liên hệ với chúng tôi</h1>

    <div class="contact-layout">
        <div class="contact-info">
            <div class="contact-item"><strong>📞 Hotline</strong><p>0855 081 828</p></div>
            <div class="contact-item"><strong>✉️ Email</strong><p>hotro@nova.vn</p></div>
            <div class="contact-item"><strong>📍 Địa chỉ</strong><p>Hà Nội, Việt Nam</p></div>
            <div class="contact-item"><strong>🕐 Giờ làm việc</strong><p>8:00 - 21:00 hằng ngày</p></div>
        </div>

        <form method="post" class="contact-form">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">@Html.ValidationSummary(true)</div>
            }
            <div class="form-group"><label>Họ tên</label><input name="FullName" required /></div>
            <div class="form-row">
                <div class="form-group"><label>Email</label><input name="Email" type="email" required /></div>
                <div class="form-group"><label>Số điện thoại</label><input name="Phone" /></div>
            </div>
            <div class="form-group"><label>Chủ đề</label><input name="Subject" /></div>
            <div class="form-group"><label>Nội dung</label><textarea name="Message" rows="5" required></textarea></div>
            <button type="submit" class="btn-primary">Gửi tin nhắn</button>
        </form>
    </div>
</div>


