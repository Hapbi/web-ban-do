@model Order
@{ ViewData["Title"] = "Đơn hàng " + Model.Code; }

<div class="container order-detail-page">
    <a href="/don-hang" class="back-link">← Tất cả đơn hàng</a>

    <div class="order-detail-header">
        <div>
            <h1>Đơn hàng #@Model.Code</h1>
            <p class="muted">Đặt lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <span class="status-badge large status-@Model.Status.Color()">@Model.Status.Label()</span>
    </div>

    <div class="order-timeline">
        @foreach (var h in Model.History.OrderBy(h => h.CreatedAt))
        {
            <div class="timeline-step active">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <strong>@h.Status.Label()</strong>
                    <div class="muted small">@h.CreatedAt.ToString("dd/MM HH:mm")</div>
                    @if (!string.IsNullOrEmpty(h.Note)) { <div class="small">@h.Note</div> }
                </div>
            </div>
        }
    </div>

    <div class="order-detail-grid">
        <div>
            <h2>Sản phẩm</h2>
            <div class="order-items-list">
                @foreach (var i in Model.Items)
                {
                    <div class="order-detail-item">
                        <img src="@i.ProductImage" alt="" onerror="this.onerror=null;this.src='/images/products/fallback.svg'" />
                        <div class="flex-1">
                            <a href="/san-pham/@i.ProductSlug">@i.ProductName</a>
                            <div class="muted">@i.Quantity × @i.UnitPrice.ToString("N0")đ</div>
                        </div>
                        <strong>@i.LineTotal.ToString("N0")đ</strong>
                    </div>
                }
            </div>

            <h2>Giao đến</h2>
            <div class="order-address">
                <strong>@Model.CustomerName</strong><br />
                @Model.Phone<br />
                @Model.Address<br />
                @if (!string.IsNullOrEmpty(Model.Note)) { <span class="muted">Ghi chú: @Model.Note</span> }
            </div>
        </div>

        <aside class="order-summary">
            <h2>Tổng kết</h2>
            <div class="summary-rows">
                <div class="summary-row"><span>Tạm tính</span><strong>@Model.Subtotal.ToString("N0")đ</strong></div>
                @if (Model.Discount > 0) { <div class="summary-row"><span>Giảm giá</span><strong>−@Model.Discount.ToString("N0")đ</strong></div> }
                <div class="summary-row">
                    <span>Vận chuyển</span>
                    @if (Model.Shipping == 0) { <strong class="text-success">Miễn phí</strong> }
                    else { <strong>@Model.Shipping.ToString("N0")đ</strong> }
                </div>
                <div class="summary-row summary-total"><span>Tổng</span><strong>@Model.Total.ToString("N0")đ</strong></div>
            </div>
            <div class="payment-info">
                <div><strong>Thanh toán:</strong> @Model.PaymentMethod.Label()</div>
                <div><strong>Trạng thái:</strong> @Model.Payment.Label()</div>
            </div>
            @if (Model.PaymentMethod == PaymentMethod.BankTransfer && Model.Payment != PaymentStatus.Paid && Model.Status != OrderStatus.Cancelled)
            {
                var bank = ViewBag.Bank as BankSettings;
                <div class="bank-transfer-card" style="margin-top:1.25rem">
                    <h3>🏦 Thông tin chuyển khoản</h3>
                    @if (bank != null)
                    {
                        <p><strong>Ngân hàng:</strong> @bank.BankName</p><p><strong>Số tài khoản:</strong> @(string.IsNullOrWhiteSpace(bank.AccountNumber) ? "Cửa hàng chưa cấu hình số tài khoản" : bank.AccountNumber)</p><p><strong>Chủ tài khoản:</strong> @bank.AccountHolder</p>
                        @if (!string.IsNullOrWhiteSpace(bank.QrImageUrl)) { <img src="@bank.QrImageUrl" alt="QR chuyển khoản" style="max-width:210px;max-height:210px;object-fit:contain"/> }
                        <p><strong>Số tiền:</strong> @Model.Total.ToString("N0")đ</p><p><strong>Nội dung:</strong> @ViewBag.TransferMemo</p><p class="muted small">@bank.Instructions</p>
                    }
                    <hr/><h4>Gửi đường dẫn chứng từ</h4><p class="muted small">Chỉ gửi sau khi chuyển tiền thật. Nhân viên sẽ đối chiếu với tài khoản ngân hàng.</p>
                    <form method="post" action="/don-hang/@Model.Code/chung-tu" class="stack-form"><label>URL ảnh / chứng từ chuyển khoản</label><input type="url" name="proofUrl" value="@Model.PaymentProofUrl" required placeholder="https://..."/><label>Ghi chú</label><input name="note" value="@Model.PaymentNote" placeholder="Thời điểm chuyển, tên người chuyển..."/><button class="btn-primary">Gửi chứng từ</button></form>
                </div>
            }
        </aside>
    </div>
</div>


