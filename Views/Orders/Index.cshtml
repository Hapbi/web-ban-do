@model List<Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }

<div class="container orders-page">
    <div class="page-header">
        <h1>Đơn hàng của tôi</h1>
        <a href="/tra-cuu" class="btn-ghost">🔍 Tra cứu đơn</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3>Chưa có đơn hàng</h3>
            <p>Bắt đầu mua sắm để xem đơn hàng tại đây.</p>
            <a href="/san-pham" class="btn-primary">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var o in Model)
            {
                <div class="order-card reveal">
                    <div class="order-header">
                        <div>
                            <strong>#@o.Code</strong>
                            <span class="muted">· @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <span class="status-badge status-@o.Status.Color()">@o.Status.Label()</span>
                    </div>
                    <div class="order-items">
                        @foreach (var i in o.Items)
                        {
                            <div class="order-item-row">
                                <img src="@i.ProductImage" alt="" onerror="this.onerror=null;this.src='/images/products/fallback.svg'" />
                                <span>@i.ProductName ×@i.Quantity</span>
                                <span class="price-current">@i.LineTotal.ToString("N0")đ</span>
                            </div>
                        }
                    </div>
                    <div class="order-footer">
                        <div>
                            <span class="muted">Tổng:</span>
                            <strong class="price-current">@o.Total.ToString("N0")đ</strong>
                        </div>
                        <a href="/don-hang/@o.Code" class="btn-ghost">Xem chi tiết →</a>
                    </div>
                </div>
            }
        </div>
    }
</div>


