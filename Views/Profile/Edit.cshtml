@model NovaShop.Models.User
@{
    ViewData["Title"] = "Sửa thông tin cá nhân";
}

<div class="container profile-page">
    <div class="page-header" style="margin-bottom:22px">
        <div>
            <p class="eyebrow">TÀI KHOẢN BTVH</p>
            <h1>Chỉnh sửa thông tin</h1>
            <p class="muted">Cập nhật thông tin liên hệ để cửa hàng hỗ trợ và giao hàng chính xác hơn.</p>
        </div>
        <a class="btn-ghost" href="/tai-khoan">← Quay lại tài khoản</a>
    </div>

    <div class="card seller-form">
        <form method="post" action="/tai-khoan/sua">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="fullName">Họ và tên</label>
                <input id="fullName" name="fullName" value="@Model.FullName" required minlength="2" maxlength="120" autocomplete="name" />
            </div>
            <div class="form-group">
                <label for="phone">Số điện thoại</label>
                <input id="phone" name="phone" value="@Model.Phone" required maxlength="30" autocomplete="tel" inputmode="tel" />
            </div>
            <div class="form-group">
                <label for="email">Email đăng nhập</label>
                <input id="email" value="@Model.Email" disabled readonly />
                <small class="muted">Email được dùng để đăng nhập nên không thể sửa tại màn hình này.</small>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px">
                <button type="submit" class="btn-primary">Lưu thay đổi</button>
                <a href="/tai-khoan" class="btn-ghost">Hủy</a>
            </div>
        </form>
    </div>
</div>
