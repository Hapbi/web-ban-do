@model ProfileVM
@{ ViewData["Title"] = "Tài khoản"; }

<div class="container profile-page">
    <div class="profile-header">
        <div class="profile-avatar">@Model.User.Avatar</div>
        <div>
            <h1>@Model.User.FullName</h1>
            <p class="muted">@Model.User.Email</p>
        </div>
        <a href="/tai-khoan/sua" class="btn-ghost">Sửa thông tin</a>
    </div>

    <div class="profile-stats">
        <div class="stat-card"><div class="stat-number">@Model.TotalOrders</div><div class="stat-label">Đơn hàng</div></div>
        <div class="stat-card"><div class="stat-number">@Model.TotalSpent.ToString("N0")đ</div><div class="stat-label">Đã chi tiêu</div></div>
        <div class="stat-card"><div class="stat-number">@Model.WishlistCount</div><div class="stat-label">Yêu thích</div></div>
        <div class="stat-card"><div class="stat-number">@Model.ReviewCount</div><div class="stat-label">Đánh giá</div></div>
    </div>

    <div class="profile-tabs">
        <a href="/tai-khoan" class="tab-link active">Tổng quan</a>
        <a href="/don-hang" class="tab-link">Đơn hàng</a>
        <a href="/tai-khoan/dia-chi" class="tab-link">Địa chỉ</a>
        <a href="/yeu-thich" class="tab-link">Yêu thích</a>
    </div>

    <div class="profile-section">
        <h2>Đơn hàng gần đây</h2>
        @if (Model.RecentOrders.Any())
        {
            <div class="orders-list">
                @foreach (var o in Model.RecentOrders)
                {
                    <div class="order-card">
                        <div class="order-header">
                            <strong>#@o.Code</strong>
                            <span class="status-badge status-@o.Status.Color()">@o.Status.Label()</span>
                        </div>
                        <div class="order-footer">
                            <span>@o.CreatedAt.ToString("dd/MM/yyyy") · <strong>@o.Total.ToString("N0")đ</strong></span>
                            <a href="/don-hang/@o.Code" class="btn-ghost">Chi tiết →</a>
                        </div>
                    </div>
                }
            </div>
        }
        else { <p class="muted">Chưa có đơn hàng.</p> }
    </div>
</div>


